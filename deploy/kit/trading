  fi
}

# 读同机 TopUP 配置里的一个值（只读；没有这个文件或这一项时为空）
topup_val() { [ -r "$TOPUP_ENVF" ] && awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); v=$0} END{printf "%s", v}' "$TOPUP_ENVF" || true; }

# 邮件：同机有 TopUP 时沿用它的发件地址、收件人（MAIL_FROM、MAIL_TO），问要不要沿用它的 Resend Key（本地复制，不显示）；
# 读不到（临时第二台）时逐项问。告警收件人 = MAIL_TO，FX_PUSH_VAPID_SUBJECT = mailto:MAIL_TO 的第一个
setup_mail() {
  local from to yn key shost
  from=$(topup_val MAIL_FROM); to=$(topup_val MAIL_TO)
  if [ -n "$from" ] && [ -n "$to" ]; then
    envset FX_MAIL_FROM "$from"; envset FX_ALERT_EMAILS "$to"; envset FX_RISK_ALERT_EMAILS "$to"
    ok "发件地址、收件人：沿用 TopUP 的（$from → $to）"
    key=$(topup_val RESEND_API_KEY); shost=$(topup_val SMTP_HOST)
    if [ -n "$key" ] || [ -n "$shost" ]; then
      read -r -p "是否沿用 TopUP 的 Resend Key（是 = 直接回车或输入 是，否 = 输入 否）：" yn || true
    else
      yn=否; ok "TopUP 的配置里没有 Resend Key，下面隐藏输入"
    fi
    if [ "$yn" != 否 ] && [ "$yn" != n ] && [ "$yn" != N ] && [ -n "$key" ]; then
      # Resend 的 SMTP：用户名 resend、密码就是 API Key（TopUP 用的是 Resend 的接口，同一个 Key）
      envset FX_MAIL_HOST smtp.resend.com; envset FX_MAIL_PORT 587; envset FX_MAIL_SECURITY STARTTLS; envset FX_MAIL_USERNAME resend
      envset FX_MAIL_PASSWORD "$key"; unset key
      ok "Resend Key：已从 TopUP 的配置本地复制（不显示值）"
    elif [ "$yn" != 否 ] && [ "$yn" != n ] && [ "$yn" != N ] && [ -n "$shost" ]; then
      envset FX_MAIL_HOST "$shost"; envset FX_MAIL_PORT "$(topup_val SMTP_PORT)"; envset FX_MAIL_USERNAME "$(topup_val SMTP_USER)"
      if [ "$(topup_val SMTP_SECURE)" = true ]; then envset FX_MAIL_SECURITY SSL; else envset FX_MAIL_SECURITY STARTTLS; fi
      envset FX_MAIL_PASSWORD "$(topup_val SMTP_PASS)"
      ok "SMTP 设置：已从 TopUP 的配置本地复制（不显示值）"
    else
      envset FX_MAIL_HOST smtp.resend.com; envset FX_MAIL_PORT 587; envset FX_MAIL_SECURITY STARTTLS; envset FX_MAIL_USERNAME resend
      ask_secret FX_MAIL_PASSWORD "Resend API Key（权限 Sending access、只选发信域名）"
    fi
    unset key
    envset FX_PUSH_VAPID_SUBJECT "mailto:${to%%,*}"
    apply > /dev/null || true
    cmd_test_mail || true
  else
    ok "这台机器上读不到 TopUP 的邮件设置（临时第二台？），逐项输入"
    cmd_keys mail
    to=$(envget FX_ALERT_EMAILS)
    [ -z "$to" ] || { envset FX_PUSH_VAPID_SUBJECT "mailto:${to%%,*}"; apply > /dev/null || true; }
  fi
}

