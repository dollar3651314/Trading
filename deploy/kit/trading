  envset FX_PUSH_VAPID_SUBJECT "mailto:$email"

  say "== 6/9 HTTPS 证书（Let's Encrypt，一张证书四个子域名）"
  if [ ! -f /etc/letsencrypt/live/trading/fullchain.pem ]; then
    # 第一次：TopUP 已停、80 空着，用 certbot 自己的临时服务验证；之后改成 webroot（/var/www/certbot），哪边的 Nginx 在跑就由哪边应答（07 页第 5 节）
    compose stop trading-web > /dev/null 2>&1 || true
    if certbot certonly --standalone -n --agree-tos -m "$email" --cert-name trading -d "$app" -d "$admin" -d "$www" -d "$quote" > /dev/null 2>&1; then
