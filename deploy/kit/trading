SET_PROD="TR_REAL_IP_FROM TR_REAL_IP_HEADER TR_QUOTE_BIND"

# 真实 IP 的地址段（照 TopUP topup.sh 的 realip_from_ok）：IPv4（前缀 16～32）或 IPv6（前缀 48～128），不写前缀 = 单个地址；
# 不能和 Docker 默认地址池 172.17.0.0～172.31.255.255 重叠（端口转发经过 docker-proxy 时 Nginx 看到的来源在这里面，信任它等于信任所有人带的请求头）
ipv4_int() {
  local IFS=. o n=0 parts
  read -ra parts <<< "$1"
  [ "${#parts[@]}" = 4 ] || return 1
  for o in "${parts[@]}"; do
    [[ $o =~ ^[0-9]{1,3}$ ]] && [ $((10#$o)) -le 255 ] || return 1
    n=$(( n * 256 + 10#$o ))
  done
  echo "$n"
}
ipv6_ok() {
  local a=$1 left right g groups=()
  [[ $a =~ ^[0-9A-Fa-f:]+$ ]] || return 1
  if [[ $a == *::* ]]; then
    left=${a%%::*}; right=${a#*::}
    [[ $right != *::* ]] || return 1
    [ -z "$left" ] || { IFS=: read -ra g <<< "$left"; groups+=("${g[@]}"); [[ $left != *: ]] || return 1; }
    [ -z "$right" ] || { IFS=: read -ra g <<< "$right"; groups+=("${g[@]}"); [[ $right != :* && $right != *: ]] || return 1; }
    [ "${#groups[@]}" -le 7 ] || return 1
  else
    IFS=: read -ra groups <<< "$a"
    [ "${#groups[@]}" = 8 ] && [[ $a != *: ]] || return 1
  fi
  for g in "${groups[@]}"; do [[ $g =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1; done
}
realip_from_ok() {
  local v=$1 item addr pfx n start end lo hi
  case "$v" in '' | ,* | *, | *,,*) return 1 ;; esac
  lo=$(ipv4_int 172.17.0.0); hi=$(ipv4_int 172.31.255.255)
  for item in ${v//,/ }; do
    addr=${item%%/*}; pfx=
    [[ $item == */* ]] && { pfx=${item#*/}; [[ $pfx =~ ^[0-9]{1,3}$ ]] || return 1; pfx=$((10#$pfx)); }
    if n=$(ipv4_int "$addr"); then
      pfx=${pfx:-32}; [ "$pfx" -ge 16 ] && [ "$pfx" -le 32 ] || return 1
      start=$(( n & ~((1 << (32 - pfx)) - 1) )); end=$(( start + (1 << (32 - pfx)) - 1 ))
      [ "$end" -lt "$lo" ] || [ "$start" -gt "$hi" ] || return 1
    elif ipv6_ok "$addr"; then
      pfx=${pfx:-128}; [ "$pfx" -ge 48 ] && [ "$pfx" -le 128 ] || return 1
    else
      return 1
    fi
  done
}

# 生产才有的设置：先检查值，改完经 Nginx 的后台端口查一次健康检查，不通过就换回原来的值
set_prod() {
  local k=$1 v=$2 old body _
  case "$k" in
    TR_REAL_IP_HEADER) case "$v" in off | X-Forwarded-For | X-Real-IP) ;; *) die "TR_REAL_IP_HEADER 只能是 off、X-Forwarded-For、X-Real-IP（按实测网关带的那个填）；什么都没有改" ;; esac ;;
    TR_REAL_IP_FROM) [ -z "$v" ] || [ "$v" = off ] || realip_from_ok "$v" || die "TR_REAL_IP_FROM 要是网关的地址段（逗号分隔；IPv4 前缀 16～32、IPv6 48～128），不能和 Docker 的 172.17～172.31 重叠；什么都没有改"
      [ "$v" != off ] || v="" ;;
    TR_QUOTE_BIND) case "$v" in 127.0.0.1 | 0.0.0.0) ;; *) die "TR_QUOTE_BIND 只能是 127.0.0.1（报价对外不发布，默认）或 0.0.0.0（在平台上发布 8085 时）" ;; esac ;;
  esac
  old=$(envget "$k")
  envset "$k" "$v"; ok "$k 已更新"; log "$k 改成 ${v:-空}"
  apply || true
  trading_running || return 0
  for _ in 1 2 3 4 5; do body=$(curl -s --max-time 5 http://127.0.0.1:8083/api/health 2> /dev/null || true); [ "$(health_field status "$body")" = UP ] && break; body=""; sleep 2; done
  if [ -z "$body" ]; then
    envset "$k" "$old"; apply > /dev/null 2>&1 || true
    die "改了以后经 Nginx 的后台端口 8083 健康检查没有通过，已换回原来的 $k"
  fi
  if [ "$k" != TR_QUOTE_BIND ]; then
    if [ -n "$(envget TR_REAL_IP_FROM)" ] && [ "$(envget TR_REAL_IP_HEADER)" != off ] && [ -n "$(envget TR_REAL_IP_HEADER)" ]; then
      ok "真实 IP：开（$(envget TR_REAL_IP_HEADER)，只认 $(envget TR_REAL_IP_FROM) 来的）"
    else
      ok "真实 IP：关（两项都填了才开；关的时候应用看到的访客 IP 都是平台网关的地址）"
    fi
  fi
}
KEY_ALLOWED="FX_TOPUP_API_KEY FX_TOPUP_API_SECRET FX_MAIL_PASSWORD FX_QUOTE_ALLTICK_TOKEN FX_QUOTE_ITICK_TOKEN"

cmd_set() {
  need_root
  # 模式开关只影响下一次 on / off，不重启容器（apply 会在 Trading 停着时把它拉起来）
  if [ "${1:-}" = TR_SHARE_WITH_TOPUP ] && [ $# -eq 2 ]; then
    prod && die "生产和 TopUP 生产共存（从不停它），没有轮流模式"
    case "$2" in true | false) ;; *) die "TR_SHARE_WITH_TOPUP 只能是 true（和 TopUP 轮流用这台机器）或 false（独立，不碰 TopUP）" ;; esac
    envset TR_SHARE_WITH_TOPUP "$2"; ok "模式：$(mode_name)（下一次 sudo trading on / off 起生效）"; log "模式改成 $2"; return 0
  fi
  if prod && [[ " $SET_PROD " == *" ${1:-} "* ]]; then [ $# -eq 2 ] || die "用法：sudo trading set $1 <值>"; set_prod "$1" "$2"; return; fi
  [ $# -eq 2 ] || die "用法：sudo trading set <变量名> <值>；能改的：$SET_ALLOWED$(prod && echo " $SET_PROD" || echo " TR_SHARE_WITH_TOPUP")（密钥用 set-key）"
  [[ " $SET_ALLOWED " == *" $1 "* ]] || die "$1 不在可改清单里：$SET_ALLOWED$(prod && echo " $SET_PROD")（密钥用 sudo trading set-key）"
  envset "$1" "$2"; ok "$1 已更新"
  apply
}

cmd_set_key() {
  need_root; need_tty
  [ $# -eq 1 ] || die "用法：sudo trading set-key <变量名>；能改的：$KEY_ALLOWED"
  [[ " $KEY_ALLOWED " == *" $1 "* ]] || die "$1 不在清单里：$KEY_ALLOWED"
  read_secret "粘贴 $1（屏幕上不显示，粘完按回车；直接回车 = 不改）："
  if [ -n "$REPLY_SECRET" ]; then envset "$1" "$REPLY_SECRET"; ok "$1 已更新（不显示值）"; apply; else say "没改"; fi
  REPLY_SECRET=
}

# 问一个不是密钥的值，输出到标准输出（提示写到终端）
ask_val() {
  local v
  read -r -p "$1 [${2:-空}]：" v < /dev/tty > /dev/tty || true
  printf '%s' "${v:-$2}"
}

# 中文向导：逐项问，直接回车 = 保留现在的值
ask() {
  local name=$1 label=$2 def cur v
  cur=$(envget "$name"); def=${cur:-${3:-}}
  read -r -p "$label [${def:-空}]：" v || true
  v=${v:-$def}
  [ -n "$v" ] && envset "$name" "$v"
  return 0
}
ask_secret() {
  local name=$1 label=$2 state
  if [ -n "$(envget "$name")" ]; then state="已填过"; else state="还没填"; fi
  read_secret "$label（$state；屏幕上不显示，粘完按回车；直接回车 = 不改）："
  if [ -n "$REPLY_SECRET" ]; then envset "$name" "$REPLY_SECRET"; ok "$name 已保存（不显示值）"; else ok "$name 没改（$state）"; fi
  REPLY_SECRET=
}

