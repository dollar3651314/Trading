    && ok "证书自动续期" || bad "证书续期设置失败（不影响现在使用，截图给主会话）"
  install_units
  sysctl_ enable --now "${TIMERS[@]}" > /dev/null 2>&1 && ok "定时器：每分钟更新（trading-deploy）、每天北京时间 03:30 备份、每 5 分钟检查"
  if [ -z "$(ls -A "$TR_DIR/backup" 2>/dev/null)" ]; then
    if cmd_backup first > /dev/null; then ok "第一份备份"; else bad "第一份备份没做成（原因见上面一行；不影响使用，之后每天北京时间 03:30 自动备份，也可以 sudo trading backup）"; fi
  fi

  say "== 9/9 摘要（没有任何密钥）"
