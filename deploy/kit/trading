    die "拉不到镜像 $REG/trading-app:staging：GitHub 上三个包（trading-app、trading-quote、trading-web）要先设为 Public（操作步骤第 6 步），或者 CI 还没推出第一个镜像"
  fi
  TR_FIRST=1 cmd_update || die "启动失败，看 $LOGF；改好后再运行同一条命令"

  say "== 8/9 证书改为经 Nginx 自动续期（续完自动重新加载 Nginx）；打开定时器"
