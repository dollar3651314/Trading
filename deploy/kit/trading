#!/usr/bin/env bash
# Trading 的服务器命令（测试环境：第 4 批，部署方案 v1 03 页第 6 节；生产：生产方案 v1 07 页 R-3、R-4）。装在 /opt/trading/trading，链接成 /usr/local/bin/trading，用 root 运行。
# 两种环境，看 .env 的 TR_ENV（装的时候定，之后不能改；命令前面写的 TR_ENV=… 和 .env 不一致就停）：
#   测试环境（没写 TR_ENV）：跟 staging 标签；域名 + Let's Encrypt 证书，Nginx 占 80、443；和 TopUP 测试轮流或独立（见下面 on / off）
#   生产（TR_ENV=production）：跟 production 标签（Amos 在 GitHub 批准后才移动）；平台网关（InstaBox）做 HTTPS，Nginx 只听 8082 客户端、8083 后台、
#     8084 官网、8085 报价对外（默认只绑本机）；不装 certbot；和 TopUP 生产共存：**从不调 topup stop / start**，看到 TopUP 在跑照常启动；
#     内存门槛 2,600 MB、内存守护 300 MB；测试管理员一律拒绝；备份上限 0.6 GB、UTC 18:10；磁盘保护（装前剩 ≥ 4 GB 等，见 disk_* 函数）
#   sudo trading install --production <客户端主机名> <后台主机名> <官网主机名> [报价主机名]
#                              生产一次性安装（bootstrap.sh --production 调用，可重复运行）：主机名是平台给每个端口的地址（8082-<编号>.instabox.tech 这样，不带 https://）
#   sudo trading install <客户端域名> <后台域名> <官网域名> <报价域名> <告警邮箱> [TopUP 测试环境地址]
#                              一次性安装（bootstrap.sh 调用，可重复运行，不问问题、不涉及密钥）：（轮流模式先停 TopUP，独立模式不碰）→ 装软件、生成内部密码和 Key、申请证书、启动、打开定时器、打印摘要
#   sudo trading setup         中文向导（隐藏输入，要终端）：① 邮件（同机有 TopUP 就沿用它的 MAIL_FROM、MAIL_TO，问是否沿用它的 Resend Key；只读不改）并发测试邮件 ② 后台第一个超管的初始密码 ③ 验收令牌（测试管理员）
#                              ④ TopUP Key / Secret（可跳过，联调时填）⑤ 备份（恢复演练不在这里做，在 trading off 时做）；最后打印摘要
#   sudo trading on / off      启动 / 停止 Trading。两种模式，看 .env 的 TR_SHARE_WITH_TOPUP（sudo trading set TR_SHARE_WITH_TOPUP true|false）：
#                              独立（默认，没写也是）：这台机器只跑 Trading（Amos 11/18：TopUP 测试环境已搬走，Trading 上生产后再搬回来）。
#                                on  = 确认 80/443 空着、可用内存 ≥ 1,000 MB（TR_MIN_MEM_MB）才启动 Trading；**不碰 TopUP**（有 TopUP 的容器在跑就不启动，不替它停）
#                                off = 拿自动更新的锁 → 停 Trading 定时器 → 停应用 → 备份 → 停 MySQL、Redis、Nginx → 恢复演练；**不启动 TopUP**
#                              和 TopUP 轮流（TR_SHARE_WITH_TOPUP=true，部署方案 07 页 TD4-20 = B，TopUP 搬回来以后再打开）：
#                                on  = 先调 TopUP 自己的 topup stop，其余同上（不够就恢复 TopUP）；off = 同上，最后调 TopUP 自己的 topup start
#                                    一般 2–5 分钟，最坏约 25 分钟；在"远程连接"的终端里运行（用"云助手"时超时设 ≥ 30 分钟）；中途断了会自己收尾：没停完就恢复 Trading，停完了（轮流模式）就启动 TopUP
#   sudo trading keys [topup|mail]   中文向导：逐项问、Key / Secret / 邮件密码隐藏输入，写进 .env 后自动生效（要在"远程连接"的终端里运行）
#   sudo trading set <变量名> <值>   改一个不是密钥的设置（只认清单里的名字）
#   sudo trading set-key <变量名>    隐藏输入改一个密钥（只认清单里的名字，要终端）
#   sudo trading status              当前版本、容器、健康检查、定时器、磁盘、内存、备份、证书（不显示任何值）
#   sudo trading mem                 每个容器的内存：当前、峰值（容器启动以来）、上限、anon（程序）/ file（文件缓存）/ shmem / slab、交换分区（MiB），
#                                    超限次数（触顶、被内核杀进程）、重启次数、24 小时内被内核按内存超限杀掉的记录，
#                                    再加 MySQL 的连接数、打开的表、临时表等计数和关键参数（只读，不显示任何密钥）
#   sudo trading update              看 staging 有没有新版本，有就备份 → 换 → 健康检查，不通过自动换回（定时器每分钟运行）
#   sudo trading retry               清掉"跳过的版本"，下一分钟重试
#   sudo trading rollback [提交号]   换回上一个（或指定）版本，并暂停自动更新到当前 staging 版本
#   sudo trading backup [名字]       加密备份（两个库、Redis、证件照片、.env），本机留 7 天；mysqldump 失败或导出不完整就算失败（不留文件、返回非 0）
#   sudo trading restore-drill       恢复演练：解密最新备份 → 导入不联网的临时 MySQL → 核对表和行数 → 删临时文件（trading off 自动做；Trading 在跑时手动运行会先停它的应用）
#   sudo trading test-mail           给告警邮箱发一封测试邮件
#   sudo trading memguard            内存守护（定时器每 30 秒）：可用内存低于 80 MB（生产 300 MB；TR_MEMGUARD_MB）就停 Trading 的全部容器、停自动更新、发邮件；不碰 TopUP
#   sudo trading backup [名字] [--with-photos]   证件照片不进每天的包（生产方案 03 页）：每周自动一次增量（只打包上次以后新增、改过的照片），--with-photos 打包全部
#   sudo trading restore-photos      把照片备份按时间顺序解回 data/storage（只补缺的文件，不覆盖已有的）
#   sudo trading restore <备份文件> --confirm [--production]   真恢复（生产要多写 --production）：先备份现在的数据 → 停应用 → 导入 → 起应用；
#                                    恢复后**暂停把提现交给 TopUP**（备份之后已交的提现会变回"已审核待放款"，再交就重复付款），人工在 TopUP 后台核对后：
#   sudo trading start-payout --confirm   恢复提现交给 TopUP
#   sudo trading backup-key <age 公钥> | off   备份另加 Amos 的公钥（私钥在 Amos 的密码管理器）；off = 去掉
#   sudo trading watch               每 5 分钟的检查（含 24 小时内容器被内核按内存超限杀掉），状态变化时发邮件（定时器运行；trading-deploy 定时器停着时不检查）
# 给 TopUP 用的约定（TopUP topup.sh 的 stop_other）：装在 /opt/trading/，更新定时器叫 trading-deploy.timer，/opt/trading/backup.sh before-topup 能备份
#   sudo trading gen-test-admin      设测试管理员令牌：Amos 用密码管理器生成 40 位，这里隐藏输入；.env 只存 SHA-256，屏幕上不显示（再运行一次就换）
#   sudo trading test-admin-off      关掉测试管理员（删哈希，旧令牌立刻作废）
# 规矩（底线 1）：任何密钥、密码、Token 都不打印到屏幕、不写日志、不放命令行参数。
# 阿里云"云助手 → 执行命令"没有终端：要输入或显示密钥的命令（setup、keys、set-key、gen-test-admin）在那里会拒绝，改用"远程连接"。
set -euo pipefail
umask 077

TR_DIR=${TR_DIR:-/opt/trading}
REG=${TR_REGISTRY:-ghcr.io/dollar3651314}
IMAGES=(trading-app trading-quote trading-web)
ENVF="$TR_DIR/.env"
STATE="$TR_DIR/state"
LOGF="$TR_DIR/logs/trading.log"
# 启动前要求的可用内存：容器上限合计 964 + 每个容器的运行开销约 36 = 1,000（量可用内存时 Docker 守护进程已在跑；Amos 批准的 C75 例外，见 docker-compose.yml 开头）
MIN_MEM_MB=${TR_MIN_MEM_MB:-1000}
# 内存守护：可用内存低于这个数（MB）就只停 Trading（不碰 TopUP）
MEMGUARD_MB=${TR_MEMGUARD_MB:-80}
# 恢复演练用的临时 MySQL 上限（MB）；缓冲池 32 MB、不用交换分区、内存 320（比正式库 272 多：导入比日常重，演练时 Trading 的应用都停着），实测空闲约 172 MB，导入时更多
DRILL_MEM_MB=${TR_DRILL_MEM_MB:-320}
# 备份时 mysqldump 最多等几秒（测试库导出正常几秒钟；卡住就算失败，不无限等）。要明显小于 trading-deploy.service 的 15 分钟，免得 systemd 先杀
DUMP_TIMEOUT=${TR_DUMP_TIMEOUT:-300}
# 恢复演练：等临时库就绪、导入各最多几秒（trading off 不能被演练卡住，TopUP 要能起来）
DRILL_READY_TIMEOUT=${TR_DRILL_READY_TIMEOUT:-180}
DRILL_IMPORT_TIMEOUT=${TR_DRILL_IMPORT_TIMEOUT:-300}
# trading off 等进行中的自动更新最多几秒（等不到就不切换、什么都不动）
OFF_LOCK_WAIT=${TR_OFF_LOCK_WAIT:-300}
TOPUP_BIN=${TR_TOPUP_BIN:-/usr/local/bin/topup}
# 同机 TopUP 的应用配置（邮件设置从这里读，只读不改；Amos 11/17「邮箱用和TopUP一样的」）
TOPUP_ENVF=${TR_TOPUP_ENV:-/opt/topup/.env}
TIMERS=(trading-deploy.timer trading-backup.timer trading-watch.timer trading-memguard.timer)
# 命令前面写的环境（sudo TR_ENV=production trading …）：和 .env 的 TR_ENV 不一致就停（check_env）
CALLER_ENV=${TR_ENV:-}

# ---------- 公共 ----------
# 退出时一定做的清理（正常结束、出错、Ctrl-C、关掉远程连接窗口、kill 都会做；kill -9 做不到，下次运行时 sweep_stale 清超过 60 分钟的）：
#   杀掉还在等的后台命令（导出、导入、等锁）和容器里的 mysqldump；删登记的临时文件（明文 SQL）和临时容器；
#   演练中途被打断时把停掉的 Trading 应用拉起来；trading off 停完 Trading 前被打断时按原样恢复 Trading、停完后被打断时照样启动 TopUP
CLEAN_PATHS=(); CLEAN_CONTAINERS=(); OFF_START_TOPUP=""; OFF_RESTORE_TRADING=""; INSTALL_HINT=""; DRILL_RESTART_PENDING=""; DRILL_MEMGUARD_WAS_ON=""; RESTORE_STAGE=""
BG_PID=""; DUMP_RUNNING=""; OFF_TOPUP_FIRST_FAILED=""
on_exit() {
  local rc=$? c p
  # 清理时不能因为任何一步出错就停下（set +e）；终端可能已经断了（远程连接窗口关掉），提示写不出去也照样往下做（say 不报错、忽略 SIGPIPE），
  # 每一步都写进日志
  set +e
  # 收尾时再来的 Ctrl-C、窗口断开、kill 一律忽略，免得收尾做到一半被打断（收尾里起的命令也继承这个忽略）
  trap '' HUP TERM INT PIPE
  if [ -n "$BG_PID" ]; then kill -TERM "$BG_PID" 2> /dev/null; wait "$BG_PID" 2> /dev/null; BG_PID=""; fi
  if [ -n "$DUMP_RUNNING" ]; then
    DUMP_RUNNING=""
    log "（被打断：正在清理 mysql 容器里的 mysqldump，最多 30 秒）"
    log "（被打断：$(kill_container_dumps)）"
  fi
  for c in "${CLEAN_CONTAINERS[@]}"; do docker rm -f "$c" > /dev/null 2>&1; done
  for p in "${CLEAN_PATHS[@]}"; do rm -rf "$p"; done
  if [ -n "$DRILL_RESTART_PENDING" ]; then log "（恢复演练被打断：重新启动 Trading 的应用）"; drill_restart_apps 1; fi
  if [ -n "$OFF_RESTORE_TRADING" ]; then OFF_RESTORE_TRADING=""; log "（trading off 没做完：Trading 按原样恢复、定时器打开，TopUP 不启动）"; off_restore_trading; fi
  # TopUP：正在启动时被打断的，bash 会等那条 topup start 做完才到这里；做成了（有标记文件）就不再启动，没做成再启动一次
  local topup_failed=""
  if [ -n "$OFF_START_TOPUP" ]; then
    if [ -f "$STATE/topup-started.$$" ]; then
      log "（trading off 被打断：TopUP 已经启动好了）"
    else
      if [ -n "$OFF_TOPUP_FIRST_FAILED" ]; then log "（第一次 topup start 没成功，再试一次）"; else log "（trading off 被打断：Trading 已全停，照样启动 TopUP）"; fi
      if ! restart_topup; then
        topup_failed=1
        log "✗ topup start 两次都没成功：Trading 已全停、TopUP 没起来，测试服务器现在没有服务。看 sudo topup status，截图给主会话"
      fi
    fi
    OFF_START_TOPUP=""
  fi
  rm -f "$STATE/topup-started.$$"
  case "$RESTORE_STAGE" in
    stopped | importing | failed) log "（恢复没做完：Trading 的应用保持停着。看 $LOGF；要换回恢复前的数据，用 backup/ 里最新的 *-before-restore 备份再 sudo trading restore）" ;;
    before) sysctl_ enable --now trading-deploy.timer trading-backup.timer > /dev/null 2>&1 ;;
  esac
  if [ -n "$INSTALL_HINT" ] && [ "$rc" -ne 0 ]; then
    if prod; then say "（安装没做完。生产没碰 TopUP；改好后再运行同一条安装命令，要先停掉已经起来的 Trading 就运行 sudo trading off）"
    elif share_topup; then say "（安装没做完。轮流模式下 TopUP 可能已被停下，要先恢复它就运行 sudo trading off；改好后再运行同一条安装命令）"
    else say "（安装没做完。独立模式没碰 TopUP；改好后再运行同一条安装命令，要先停掉已经起来的 Trading 就运行 sudo trading off）"; fi
  fi
  # TopUP 两次都没起来：本来要以 0 结束的也改成 1（在退出收尾里 exit 只决定退出码，不会再进收尾）
  if [ -n "$topup_failed" ] && [ "$rc" -eq 0 ]; then exit 1; fi
  return 0
}
trap on_exit EXIT
# 管道断了（例如 trading off | tee 的 tee 被关掉）也走同一套清理；子进程不继承这个 trap，管道里的命令照常
trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP; trap 'exit 141' PIPE
# docker compose exec 一律把标准输入接到 /dev/null（或文件）：它默认转发标准输入，外面套了 timeout 时（timeout 自成后台进程组）
# 在终端里一读就被 SIGTTIN 停住，直到超时被杀（T-7）。deploy/check.sh 检查每处 exec -T 都有这个重定向
# 后台跑一个要等很久的命令（导出、导入、等锁）再 wait：这样 Ctrl-C、关窗口、kill 来了 trap 立刻执行（前台命令要等它结束才执行；
# GNU timeout 还会自成进程组，终端的 Ctrl-C 到不了它）。on_exit 会杀掉它。标准输入显式传下去（后台命令默认读 /dev/null）
run_bg() {
  "$@" <&0 &
  BG_PID=$!
  local rc=0
  wait "$BG_PID" || rc=$?
  BG_PID=""
  return "$rc"
}
# 等待时长的说法：不到 1 分钟写秒，否则写分钟
dur() { if [ "$1" -lt 60 ]; then printf '%s 秒' "$1"; else printf '%s 分钟' "$(($1 / 60))"; fi; }
# 输出写不出去（终端断了、/dev/full）不算错，不影响后面的步骤
say() { printf '%s\n' "$*" 2> /dev/null || true; }
log() { mkdir -p "$TR_DIR/logs"; rotate_log; printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOGF"; say "$*"; }
# trading.log 按大小轮转：超过 10 MB 就挪成 .1（原来的 .1～.4 往后挪，.5 删掉），最多 6 个文件约 60 MB（生产方案 03 页）
LOG_MAX_BYTES=${TR_LOG_MAX_BYTES:-10485760}
rotate_log() {
  local n
  [ "$(stat -c %s "$LOGF" 2> /dev/null || echo 0)" -gt "$LOG_MAX_BYTES" ] || return 0
  for n in 4 3 2 1; do [ ! -f "$LOGF.$n" ] || mv -f "$LOGF.$n" "$LOGF.$((n + 1))"; done
  mv -f "$LOGF" "$LOGF.1"
}
ok() { say "  ✓ $*"; }
bad() { say "  ✗ $*"; }
die() { say "✗ $*" >&2; exit 1; }
# 开发机演练和 deploy/check.sh 的演练（TR_OFFLINE_TEST）用普通用户跑，不要求 root
need_root() { [ -n "${TR_OFFLINE_TEST:-}" ] || [ "$(id -u)" = 0 ] || die "请用 root 运行（sudo trading …）"; }
need_tty() { [ -t 0 ] && [ -t 1 ] || die "这个命令要输入或显示密钥，必须在终端里运行：阿里云控制台 → 这台服务器 → 远程连接（不是\"云助手 → 执行命令\"，那里没有终端，输出还会被保存）"; }

# .env 读写。值从环境变量 TR_V 传给 awk（不出现在命令行参数里，ps 看不到）
envget() { [ -f "$ENVF" ] && awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); v=$0} END{printf "%s", v}' "$ENVF" || true; }
envset() {
  local k=$1 tmp
  case "$2" in *$'\n'*) die "$k 的值里不能有换行" ;; esac
  tmp=$(mktemp "$TR_DIR/.envnew-XXXXXX")
  TR_V="$2" awk -F= -v k="$k" 'BEGIN{v=ENVIRON["TR_V"]; done=0} $1==k{if(!done){print k "=" v; done=1}; next} {print} END{if(!done) print k "=" v}' "$ENVF" > "$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$ENVF"
}
envdel() { local tmp; tmp=$(mktemp "$TR_DIR/.envnew-XXXXXX"); awk -F= -v k="$1" '$1!=k' "$ENVF" > "$tmp"; chmod 600 "$tmp"; mv "$tmp" "$ENVF"; }
set_if_empty() { if [ -z "$(envget "$1")" ]; then envset "$1" "$2"; ok "$1：已生成"; else ok "$1：已有，不改"; fi; }
rand_hex() { openssl rand -hex "$1" | tr -d '\n'; }

COMPOSE=(docker compose --project-name trading --project-directory "$TR_DIR" -f "$TR_DIR/docker-compose.yml" --env-file "$ENVF" --env-file "$STATE/image.env")
compose() { "${COMPOSE[@]}" "$@"; }

# ---------- 测试环境 / 生产 ----------
# 生产吗：只看 .env 的 TR_ENV=production（装的时候写，之后不能改）；没写、别的值都是测试环境
prod() { [ "$(envget TR_ENV)" = production ]; }
# 自动更新跟哪个标签：生产只跟 production（CI 推 prod-<提交号>，Amos 在 GitHub 批准后才移动 production），测试跟 staging
TRACK=staging
# trading-app 健康检查口（只绑 127.0.0.1）：生产 18080（8080 是同机 TopUP 生产的），测试 8080
HEALTH_PORT=8080
# 数据库备份合计上限（MB，至少留 3 份）：测试 2 GB，生产 0.6 GB（生产方案 03 页）
BACKUP_MAX_MB=${TR_BACKUP_MAX_MB:-2048}
# 本机除了正在用的和上一个，再多留几个版本的镜像：测试 5 个，生产 0 个（只留正在用的 + 上一个，磁盘紧）
KEEP_IMAGES=5
# 恢复演练要的可用内存：测试 = 临时库 + 64，生产 800（临时库 512，生产方案 05 页）
DRILL_NEED_MB=$((DRILL_MEM_MB + 64))
# 按 .env 的 TR_ENV 定上面这些和 compose 文件（main 开头、install 写完 TR_ENV 后各调一次）
mode_defaults() {
  if prod; then
    TRACK=production; HEALTH_PORT=18080; KEEP_IMAGES=0
    MIN_MEM_MB=${TR_MIN_MEM_MB:-2600}; MEMGUARD_MB=${TR_MEMGUARD_MB:-300}
    DRILL_MEM_MB=${TR_DRILL_MEM_MB:-512}; DRILL_NEED_MB=${TR_DRILL_NEED_MB:-800}
    BACKUP_MAX_MB=${TR_BACKUP_MAX_MB:-600}
    COMPOSE=(docker compose --project-name trading --project-directory "$TR_DIR" -f "$TR_DIR/docker-compose.yml" -f "$TR_DIR/docker-compose.production.yml"
      --env-file "$ENVF" --env-file "$STATE/image.env")
  fi
}
# 镜像标签：生产是 prod-<提交号>（CI 的 image-production 只推这个），测试是提交号本身
img_tag() { if prod; then printf 'prod-%s' "$1"; else printf '%s' "$1"; fi; }
# 命令前面写的 TR_ENV（sudo TR_ENV=production trading …）和 .env 不一致就停：环境装好后不能改
check_env() {
  [ -n "$CALLER_ENV" ] && [ -f "$ENVF" ] || return 0
  local have; have=$(envget TR_ENV); [ -n "$have" ] || have=staging
  [ "$CALLER_ENV" = "$have" ] || die "命令里写的环境 TR_ENV=$CALLER_ENV 和这台机器装的（$have）不一样：环境装好后不能改，什么都没动"
}
env_name() { if prod; then echo "生产"; else echo "测试环境"; fi; }
# 开发机演练（TR_OFFLINE_TEST）没有 systemd
sysctl_() { [ -n "${TR_OFFLINE_TEST:-}" ] && return 0; systemctl "$@"; }
topup_running() { [ -n "$(docker ps -q --filter label=com.docker.compose.project=topup 2>/dev/null || true)" ]; }
# 和 TopUP 轮流用这台机器吗：只有 .env 里明确写 TR_SHARE_WITH_TOPUP=true 才算；没写、写 false 或别的值都是"独立"，
# on / off 一律不碰 TopUP（11/18 TopUP 测试环境已搬走，旧的 /usr/local/bin/topup 还在也不会被 trading off 拉起来）
# 生产一律不轮流（和 TopUP 生产共存，从不停它）
share_topup() { ! prod && [ "$(envget TR_SHARE_WITH_TOPUP)" = true ]; }
mode_name() {
  if prod; then echo "生产（和 TopUP 生产共存，不碰 TopUP）"
  elif share_topup; then echo "和 TopUP 轮流（TR_SHARE_WITH_TOPUP=true）"
  else echo "独立（不碰 TopUP）"; fi
}
# 不轮流时的说法：测试环境"独立模式"，生产"生产，和 TopUP 生产共存"
solo_name() { if prod; then echo "生产，和 TopUP 生产共存"; else echo "独立模式"; fi; }
# Trading 有容器在跑吗（停着时改设置只保存，不把它拉起来）
trading_running() { [ -n "$(docker ps -q --filter label=com.docker.compose.project=trading 2> /dev/null || true)" ]; }
port_busy() { ss -ltnH "( sport = :$1 )" 2>/dev/null | grep -q . ; }
current_tag() { sed -n 's/^IMAGE_TAG=//p' "$STATE/image.env" 2>/dev/null || true; }
# 正在用的版本的提交号（生产的标签多一个 prod- 前缀）；健康检查的 version、previous、skip、paused 都记提交号
current_rev() { local t; t=$(current_tag); printf '%s' "${t#prod-}"; }
revision() { docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$1" 2>/dev/null || true; }
pull() { [ -n "${TR_OFFLINE_TEST:-}" ] && return 0; docker pull -q "$1" > /dev/null; }
health() { curl -s --max-time 3 "http://127.0.0.1:$HEALTH_PORT/api/health" || true; }
health_field() { sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p" <<< "$2" | head -1; }
quote_healthy() { [ "$(docker inspect --format '{{.State.Health.Status}}' trading-quote-app-1 2>/dev/null)" = healthy ]; }

# 拒绝误开端到端测试接口（E2eGuard 本身也会拒，这里多一道）；生产 .env 里有测试管理员的哈希就拒绝启动并发邮件（应用本身也拒绝）
guard_env() {
  if grep -Eq '^(FX_E2E_ENABLED|SPRING_PROFILES_ACTIVE|TRADING_E2E_ENABLED)=' "$ENVF" 2>/dev/null; then
    die ".env 里有 FX_E2E_ENABLED / SPRING_PROFILES_ACTIVE：端到端测试接口只给 CI，$(env_name)不能开。删掉这一行再运行"
  fi
  if prod && [ -n "$(envget TEST_ADMIN_TOKEN_SHA256)" ]; then
    mail_once test-admin "生产 .env 里有测试管理员" "生产的 .env 里有 TEST_ADMIN_TOKEN_SHA256（测试管理员只给测试环境），Trading 拒绝启动、自动更新也停在这里。删掉这一行（sudo trading test-admin-off）再 sudo trading on。" || true
    die "生产的 .env 里有 TEST_ADMIN_TOKEN_SHA256：测试管理员只给测试环境，拒绝启动。运行 sudo trading test-admin-off 删掉"
  fi
  rm -f "$STATE/mailed-test-admin" 2> /dev/null || true
  check_mysql_swap
}
# 同一个问题只发一封邮件（每分钟的自动更新不会刷屏）；问题消失时调用方删掉标记文件
mail_once() {
  [ -f "$STATE/mailed-$1" ] && return 0
  : > "$STATE/mailed-$1" 2> /dev/null || true
  send_mail "$2" "$3"
}

# compose 认的内存写法（320m、320mb、"320M"、1g、1GB、纯数字 = 字节）换成字节；认不出来返回 1
mem_bytes() {
  local v
  v=$(printf '%s' "$1" | tr -d "\"' " | tr 'A-Z' 'a-z')
  [[ "$v" =~ ^([0-9]+)(b|k|kb|m|mb|g|gb)?$ ]] || return 1
  case "${BASH_REMATCH[2]}" in
    "" | b) echo "${BASH_REMATCH[1]}" ;;
    k | kb) echo $((BASH_REMATCH[1] * 1024)) ;;
    m | mb) echo $((BASH_REMATCH[1] * 1048576)) ;;
    g | gb) echo $((BASH_REMATCH[1] * 1073741824)) ;;
  esac
}
# 同一句提醒只写一次日志（每分钟的自动更新不会刷屏）
log_once() {
  [ "$(cat "$STATE/warned-$1" 2> /dev/null)" = "$2" ] && return 0
  printf '%s' "$2" > "$STATE/warned-$1" 2> /dev/null || true
  log "$2" > /dev/null
}
# MySQL 不再用交换分区（11/18：服务器 vm.swappiness=0、cgroup v2，容器触到上限时内核不换出程序内存，128 MB 交换额度用不上；
# 这个设置全机共用、TopUP 也在用，不改）。以前的 TR_MEMSWAP_MYSQL 已经不读，.env 里还有就提醒一次可以删掉
check_mysql_swap() {
  if [ -n "$(envget TR_MEMSWAP_MYSQL)" ]; then
    log_once memswap ".env 里的 TR_MEMSWAP_MYSQL 已经不用了（MySQL 的交换额度改成和内存一样），可以删掉这一行"
  else
    rm -f "$STATE/warned-memswap"
  fi
}

# 等新版本：trading-app 健康检查 status=UP、version=提交号，quote-app 健康（最多 3 分钟；TR_HEALTH_WAIT_S，演练和 deploy/check.sh 用）
wait_healthy() {
  local want=$1 body _
  for _ in $(seq 1 $(( ${TR_HEALTH_WAIT_S:-180} / 2 ))); do
    body=$(health)
    if [ "$(health_field version "$body")" = "$want" ] && [ "$(health_field status "$body")" = UP ] && quote_healthy; then return 0; fi
    sleep 2
  done
  return 1
}

switch_to() {
  printf 'IMAGE_TAG=%s\n' "$1" > "$STATE/image.env.new" && mv "$STATE/image.env.new" "$STATE/image.env"
  guard_env
  compose up -d --remove-orphans
}

# 从 web 镜像取出工具包（本目录的脚本、compose、systemd、mysql-init），写临时文件再改名替换；.env、data/、state/、backup/ 不动
sync_kit() {
  local tag=$1 tmp f rel
  tmp=$(mktemp -d)
  docker run --rm --entrypoint sh -v "$tmp:/out" "$REG/trading-web:$tag" -c 'cp -r /trading-kit/. /out/' || { rm -rf "$tmp"; return 1; }
  [ -s "$tmp/trading" ] && [ -s "$tmp/docker-compose.yml" ] || { rm -rf "$tmp"; return 1; }
  while IFS= read -r -d '' f; do
    rel=${f#"$tmp"/}
    mkdir -p "$(dirname "$TR_DIR/$rel")"
    cp "$f" "$TR_DIR/$rel.new" && mv "$TR_DIR/$rel.new" "$TR_DIR/$rel"
  done < <(find "$tmp" -type f -print0)
  chmod 755 "$TR_DIR/trading" "$TR_DIR"/mysql-init/*.sh
  rm -rf "$tmp"
  # 定时器文件变了才重装（开发机演练 TR_OFFLINE_TEST 没有 systemd，跳过）
  if [ -z "${TR_OFFLINE_TEST:-}" ]; then
    for f in "$TR_DIR"/systemd/trading-*; do
      cmp -s "$f" "/etc/systemd/system/$(basename "$f")" || { install_units || log "定时器文件没装上（不影响这次更新）"; break; }
    done
  fi
}

install_units() {
  cp "$TR_DIR"/systemd/trading-*.service "$TR_DIR"/systemd/trading-*.timer /etc/systemd/system/
  # 生产的每天备份放在 UTC 18:10（和同机 TopUP 生产的 19:40 错开，生产方案 05 页第 2 节）：用 systemd 的覆盖文件改时间，定时器文件本身两边一样
  local d=/etc/systemd/system/trading-backup.timer.d
  if prod; then
    mkdir -p "$d"
    printf '# trading 命令写的（生产）：每天 UTC 18:10 备份\n[Timer]\nOnCalendar=\nOnCalendar=*-*-* 18:10:00 UTC\n' > "$d/production.conf"
  else
    rm -f "$d/production.conf"
  fi
  systemctl daemon-reload
}

# 本机的镜像：正在用的和上一个不删；测试环境另外再留最近 5 个，生产不多留（KEEP_IMAGES=0，磁盘紧，回滚更早的版本时从镜像仓库重新拉）
prune_images() {
  local cur prev keep repo tag
  cur=$(current_tag); prev=$(cat "$STATE/previous" 2>/dev/null || true); [ -z "$prev" ] || prev=$(img_tag "$prev")
  for repo in "${IMAGES[@]}"; do
    keep=0
    while read -r tag; do
      [ "$tag" = staging ] || [ "$tag" = production ] && continue
      keep=$((keep + 1))
      if [ "$keep" -gt "$KEEP_IMAGES" ] && [ "$tag" != "$cur" ] && [ "$tag" != "$prev" ]; then docker image rm "$REG/$repo:$tag" > /dev/null 2>&1 || true; fi
    done < <(docker image ls "$REG/$repo" --format '{{.Tag}}')
  done
  docker image prune -f > /dev/null 2>&1 || true
}

# 发邮件（告警、测试邮件）：用 .env 里的 SMTP，密码写进临时 netrc 文件（600），不放命令行。没配邮件时只记日志
send_mail() {
  local subject body=$2 host port sec user from to url netrc msg
  if prod; then subject="[生产] Trading $1"; else subject="[测试] Trading $1"; fi
  host=$(envget FX_MAIL_HOST); port=$(envget FX_MAIL_PORT); sec=$(envget FX_MAIL_SECURITY); user=$(envget FX_MAIL_USERNAME)
  from=$(envget FX_MAIL_FROM); to=$(envget FX_ALERT_EMAILS)
  if [ -z "$host" ] || [ -z "$from" ] || [ -z "$to" ]; then log "邮件没配置，只记日志：$subject"; return 1; fi
  port=${port:-587}
  if [ "$sec" = SSL ]; then url="smtps://$host:$port"; else url="smtp://$host:$port"; fi
  netrc=$(mktemp); msg=$(mktemp)
  printf 'machine %s login %s password %s\n' "$host" "$user" "$(envget FX_MAIL_PASSWORD)" > "$netrc"
  {
    printf 'From: %s\r\nTo: %s\r\nSubject: =?UTF-8?B?%s?=\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=UTF-8\r\n\r\n' "$from" "$to" "$(printf '%s' "$subject" | base64 -w0)"
    printf '%s\r\n' "$body"
  } > "$msg"
  local rcpt=() r
  IFS=',' read -ra r <<< "$to"
  for x in "${r[@]}"; do x=$(tr -d ' ' <<< "$x"); [ -n "$x" ] && rcpt+=(--mail-rcpt "$x"); done
  if curl -s --max-time 30 --ssl-reqd --url "$url" --netrc-file "$netrc" --mail-from "$from" "${rcpt[@]}" -T "$msg"; then
    rm -f "$netrc" "$msg"; log "已发邮件：$subject"; return 0
  fi
  rm -f "$netrc" "$msg"; log "邮件发送失败：$subject"; return 1
}

# 用 .env 里的 Key / Secret 签名查一次 TopUP 余额（和 trading-app 同一套签名：HMAC-SHA256(Secret, 时间戳\n方法\n路径\nsha256(请求体))）。
# Key、Secret 经环境变量交给 python3，不进命令行参数；只报通不通和 HTTP 状态，不显示余额和任何值
topup_check() {
  local base key secret code
  base=$(envget FX_TOPUP_BASE_URL); key=$(envget FX_TOPUP_API_KEY); secret=$(envget FX_TOPUP_API_SECRET)
  if [ -z "$base" ] || [ -z "$key" ] || [ -z "$secret" ]; then bad "TopUP 还没接入（地址、Key、Secret 缺一个）"; return 1; fi
  code=$(TR_BASE="$base" TR_KEY="$key" TR_SECRET="$secret" python3 - <<'PY' 2>/dev/null || echo 000
import hashlib, hmac, os, time, urllib.request, urllib.error
base = os.environ["TR_BASE"].rstrip("/"); path = "/api/v1/balance/"; ts = str(int(time.time()))
msg = "\n".join([ts, "GET", path, hashlib.sha256(b"").hexdigest()])
sig = hmac.new(os.environ["TR_SECRET"].encode(), msg.encode(), hashlib.sha256).hexdigest()
req = urllib.request.Request(base + path, headers={"X-TopUP-Key": os.environ["TR_KEY"], "X-TopUP-Timestamp": ts, "X-TopUP-Signature": sig})
try:
    print(urllib.request.urlopen(req, timeout=15).status)
except urllib.error.HTTPError as e:
    print(e.code)
except Exception:
    print("000")
PY
)
  unset key secret
  case "$code" in
    200) ok "TopUP 已接入（签名查余额成功）" ;;
    401|403) bad "TopUP 拒绝了（HTTP $code）：Key 或 Secret 不对，或者 Secret 在 TopUP 重新生成过；用 sudo trading keys topup 重填"; return 1 ;;
    000) bad "连不上 TopUP（地址不对，或 TopUP 没开）"; return 1 ;;
    *) bad "TopUP 返回 HTTP $code（截图给主会话）"; return 1 ;;
  esac
}

# 隐藏输入读一个值到变量 REPLY_SECRET（不回显、不进历史）
read_secret() {
  local prompt=$1 v
  IFS= read -r -s -p "$prompt" v || true; printf '\n'
  REPLY_SECRET=$v
}

