  tag=$(current_tag)
  say "环境：$(env_name)（跟 $TRACK 标签）；版本：${tag:-还没部署}（上一个：$(cat "$STATE/previous" 2>/dev/null || echo 无)）"
  say "模式：$(mode_name)"
  [ -s "$STATE/skip" ] && say "  ⚠ 跳过的版本：$(cat "$STATE/skip")（修好后 sudo trading retry）"
  [ -f "$STATE/paused" ] && say "  ⚠ 自动更新已暂停到：$(cat "$STATE/paused")（手动回滚后；下一次合并时恢复）"
  [ -f "$STATE/memguard-stopped" ] && say "  ⚠ 内存守护在 $(cat "$STATE/memguard-stopped") 停了 Trading（可用内存不够）；查清原因后 sudo trading on"
  body=$(health)
  say "trading-app：status=$(health_field status "$body") version=$(health_field version "$body") env=$(health_field env "$body")"
  quote_healthy && ok "quote-app 健康" || bad "quote-app 不健康"
  local alerts
  alerts=$(sed -n 's/.*"alerts":{\([^}]*\)}.*/\1/p' <<< "$body" | tr ',' '\n' | sed -n 's/^"\([^"]*\)":"DOWN"$/\1/p' | tr '\n' ' ')
  [ -z "$alerts" ] && ok "业务告警：无" || bad "业务告警：$alerts"
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}' 2>/dev/null || true
  systemctl list-timers 'trading-*' --no-pager 2>/dev/null | head -5 || true
  say "磁盘：$(df -h / | awk 'NR==2{print $5 " 已用，剩 " $4}')；可用内存：$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo) MB"
  local lb; lb=$(ls -1t "$TR_DIR/backup"/trading-*.tar.age 2>/dev/null | head -1 || true)
  say "最近备份：$( [ -n "$lb" ] && basename "$lb" || echo 无)（数据库备份合计 $(backup_total_mb) MB，上限 ${BACKUP_MAX_MB} MB）"
  local ph; ph=$(ls -1t "$TR_DIR/backup/photos" 2>/dev/null | head -1 || true)
  say "证件照片备份：${ph:-无}（每周增量；全部打包 sudo trading backup --with-photos）"
  say "备份另加的 Amos 公钥：$([ -s "$STATE/backup-amos.pub" ] && echo 有 || echo "没有（sudo trading backup-key <公钥>）")"
  say "最近恢复演练：$(cat "$STATE/last-drill" 2>/dev/null || echo "还没做过（sudo trading off 时自动做，或 sudo trading restore-drill）")"
  if prod; then
    if [ -n "$(envget TR_REAL_IP_FROM)" ] && [ -n "$(envget TR_REAL_IP_HEADER)" ] && [ "$(envget TR_REAL_IP_HEADER)" != off ]; then
      say "真实 IP：开（$(envget TR_REAL_IP_HEADER)，只认 $(envget TR_REAL_IP_FROM) 来的）"
    else
      say "真实 IP：关（应用看到的访客 IP 都是平台网关的地址：按 IP 限流全站共用、后台 IP 白名单不能用；实测网关后 sudo trading set TR_REAL_IP_FROM / TR_REAL_IP_HEADER）"
    fi
    [ ! -f "$STATE/payout-paused" ] || say "  ⚠ 提现暂停交给 TopUP（$(cat "$STATE/payout-paused") 恢复数据后）：在 TopUP 后台核对后 sudo trading start-payout --confirm"
  else
    local exp
    exp=$(openssl x509 -enddate -noout -in /etc/letsencrypt/live/trading/fullchain.pem 2>/dev/null | cut -d= -f2 || true)
    say "证书到期：${exp:-没有证书}"
  fi
  local filled=() k
  for k in FX_TOPUP_API_KEY FX_TOPUP_API_SECRET FX_MAIL_PASSWORD FX_QUOTE_ALLTICK_TOKEN FX_QUOTE_ITICK_TOKEN TEST_ADMIN_TOKEN_SHA256; do
    if [ -n "$(envget "$k")" ]; then filled+=("$k=已填"); else filled+=("$k=空"); fi
  done
  say "Amos 填的（只说是否）：${filled[*]}"
}

# 每个容器的内存（cgroup v2）：按容器进程号找 cgroup 目录（/proc/<pid>/cgroup 的 0:: 行），不依赖容器 ID 的长短和 cgroup 驱动；
# 峰值从容器这次启动算起。anon = 程序自己的内存（到上限会被杀），file = 文件缓存（内核随时能回收）。只读
# 24 小时内被内核按内存超限杀掉的容器（docker 的 oom 事件；容器被杀后自动重启会换新的 cgroup，memory.events 清零，所以另外看事件）。
# 输出"quote-app 2 次、mysql 1 次"，没有就空。事件在 Docker 守护进程内存里，守护进程重启后就没了。
# Docker 守护进程停了或卡住（退出码非 0、15 秒超时）时输出"未知"、返回 0：脚本开着 set -e、pipefail，
# 不能因为查不到事件让 watch 在 Trading 全挂的时候连告警都发不出去（#19 审查 🔴）
oom_24h() {
  local ev
  ev=$(timeout 15 docker events --since 24h --until "$(date +%s)" --filter type=container --filter event=oom \
    --filter label=com.docker.compose.project=trading --format '{{.Actor.Attributes.name}}' 2> /dev/null < /dev/null) || { echo 未知; return 0; }
  [ -n "$ev" ] || return 0
  printf '%s\n' "$ev" | sed 's/^trading-//; s/-[0-9]*$//' | sort | uniq -c | awk '{ printf "%s%s %d 次", (NR > 1 ? "、" : ""), $2, $1 }'
}

cmd_mem() {
  local c pid st cg oom
  m_() { local v; v=$(cat "$cg/$1" 2> /dev/null) || { echo 无; return; }; [ "$v" = max ] && echo 不限 || echo $((v / 1048576)); }
  s_() { awk -v k="$1" '$1 == k { print int($2 / 1048576) }' "$cg/memory.stat" 2> /dev/null; }
  e_() { awk -v k="$1" '$1 == k { print $2 }' "$cg/memory.events" 2> /dev/null; }
  say "各容器内存（MiB；峰值从容器启动时间算起；anon = 程序内存，file = 文件缓存，可回收）"
  for c in $(docker ps -a --filter label=com.docker.compose.project=trading --format '{{.Names}}' | sort); do
    pid=$(docker inspect -f '{{.State.Pid}}' "$c" 2> /dev/null || echo 0)
    st=$(docker inspect -f '{{.State.StartedAt}}' "$c" 2> /dev/null | cut -c1-19)
    if [ "${pid:-0}" = 0 ]; then say "  $c：没在运行"; continue; fi
    cg=/sys/fs/cgroup$(awk -F: '$1 == "0" { print $3 }' "/proc/$pid/cgroup" 2> /dev/null)
    say "  $c（启动 $st UTC）：当前 $(m_ memory.current)  峰值 $(m_ memory.peak)  上限 $(m_ memory.max) | anon $(s_ anon)  file $(s_ file)  shmem $(s_ shmem)  slab $(s_ slab) | 交换 $(m_ memory.swap.current)"
    say "      这次启动以来：触到上限 $(e_ max) 次、内存不够 $(e_ oom) 次、被内核杀进程 $(e_ oom_kill) 次 | 自动重启共 $(docker inspect -f '{{.RestartCount}}' "$c" 2> /dev/null) 次"
  done
  oom=$(oom_24h || echo 未知)
  say "24 小时内被内核按内存超限杀掉：${oom:-没有}$([ "$oom" = 未知 ] && echo "（Docker 15 秒没回应，查不到）")"
  [ -n "$(compose ps -q --status running mysql 2> /dev/null)" ] || { say "MySQL 没在运行，不查连接数"; return 0; }
  say "MySQL 计数和参数（只读）："
  # 密码只在容器里由环境变量交给客户端，不出现在命令行和输出里；最多等 20 秒
  timeout 20 "${COMPOSE[@]}" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot -N -e "SHOW GLOBAL STATUS WHERE Variable_name IN (\"Uptime\",\"Threads_connected\",\"Max_used_connections\",\"Threads_cached\",\"Open_tables\",\"Opened_tables\",\"Open_table_definitions\",\"Created_tmp_tables\",\"Created_tmp_disk_tables\"); SHOW GLOBAL VARIABLES WHERE Variable_name IN (\"max_connections\",\"innodb_buffer_pool_size\",\"table_open_cache\",\"table_definition_cache\",\"thread_cache_size\",\"temptable_max_ram\",\"temptable_max_mmap\",\"log_bin\",\"innodb_flush_method\");"' 2> /dev/null < /dev/null \
    | awk '{ printf "  %-26s %s\n", $1, $2 }' || say "  查不到（MySQL 20 秒没回应）"
}

cmd_update() {
  need_root
  exec 9> "$STATE/update.lock"
  flock -n 9 || return 0
  guard_env
  pull "$REG/trading-app:$TRACK" || { log "拉不到 $TRACK 镜像（网络或包没设公开）"; return 1; }
  local new cur
  new=$(revision "$REG/trading-app:$TRACK"); cur=$(current_rev)
  [ -n "$new" ] || { log "$TRACK 镜像没有版本号，跳过"; return 1; }
  # 安装（TR_FIRST）重新运行时：上次没起来的版本不跳过；image.env 里记着的版本没在健康运行就当作还没部署过
  if [ -n "${TR_FIRST:-}" ]; then
    rm -f "$STATE/skip" "$STATE/paused"
    [ "$(health_field status "$(health)")" = UP ] || cur=""
  fi
  [ "$new" = "$cur" ] && return 0
  [ "$new" = "$(cat "$STATE/skip" 2>/dev/null || true)" ] && return 0
  [ "$new" = "$(cat "$STATE/paused" 2>/dev/null || true)" ] && return 0
  # 更新前的备份失败过：30 分钟内不再试（不每分钟重跑一次导出）；sudo trading retry 立刻重试
  local backoff
  backoff=$(cat "$STATE/backup-backoff" 2>/dev/null || echo 0)
  [ $(( $(date +%s) - backoff )) -lt 1800 ] && return 0
  # 磁盘（生产方案 03 页）：剩余 < 2 GB + 2 × 上次备份 + 0.2 GB 就不更新（新镜像约 0.1 GB、更新前备份要地方），发一封邮件；不清别人的东西
  if prod; then
    local need free
    need=$((${TR_UPDATE_MIN_DISK_MB:-2048} + 2 * $(last_backup_mb) + 205)); free=$(disk_free_mb)
    if [ "$free" -lt "$need" ]; then
      log_once disk-update "磁盘只剩 ${free} MB，更新要 ≥ ${need} MB（2 GB + 2 × 上次备份 + 0.2 GB），这次不更新 $new"
      mail_once disk-update "磁盘不够，没有更新" "新版本 $new 没有更新：根分区只剩 ${free} MB，要 ≥ ${need} MB。看 sudo trading status、sudo docker system df，截图给主会话。" || true
      return 1
    fi
    rm -f "$STATE/mailed-disk-update" "$STATE/warned-disk-update"
  fi
  rm -f "$STATE/paused"
  log "发现新版本 $new（当前 ${cur:-无}）"
  local img tag
  tag=$(img_tag "$new")
  for img in "${IMAGES[@]}"; do pull "$REG/$img:$tag" || { log "拉不到 $img:$tag，下一分钟再试"; return 1; }; done
  # 先备份（用现在的工具包），成功了才换新工具包：备份失败时服务器上的 compose 等不会变成新版本的
  if [ -n "$cur" ]; then
    if ! cmd_backup "before-${new:0:12}" > /dev/null; then
      date +%s > "$STATE/backup-backoff"
      log "更新前的备份失败，这次不更新 $new；30 分钟后再试（sudo trading retry 立刻重试）"
      send_mail "更新前的备份失败" "新版本 $new 没有更新：更新前的备份失败（原因看 $LOGF）。30 分钟后自动再试，或 sudo trading retry。" || true
      return 1
    fi
    rm -f "$STATE/backup-backoff"
  fi
  sync_kit "$tag" || { log "取不出 $tag 的工具包，下一分钟再试"; return 1; }
  switch_to "$tag" > /dev/null 2>&1 || true
  if wait_healthy "$new"; then
    if [ -n "$cur" ]; then echo "$cur" > "$STATE/previous"; fi
    log "更新成功：$new"
    prune_images
    return 0
  fi
  log "更新失败：$new 在 3 分钟内没有通过健康检查。两个应用最后 50 行日志写进 $LOGF"
  compose logs --no-color --tail 50 trading-app quote-app >> "$LOGF" 2>&1 || true
  echo "$new" > "$STATE/skip"
  if [ -n "$cur" ]; then
    switch_to "$(img_tag "$cur")" > /dev/null 2>&1 || true
    if wait_healthy "$cur"; then log "已自动换回 $cur"; else log "换回 $cur 后仍然没有通过健康检查，需要人工处理"; fi
  fi
  [ -z "${TR_FIRST:-}" ] && send_mail "更新失败：${new:0:12}" "新版本 $new 没有通过健康检查，已换回 ${cur:-（无）}。修好后合并新提交，或 sudo trading retry。" || true
  return 1
}

cmd_retry() { need_root; rm -f "$STATE/skip" "$STATE/paused" "$STATE/backup-backoff"; ok "已清掉跳过记录，下一分钟重试"; }

cmd_rollback() {
  need_root
  exec 9> "$STATE/update.lock"; flock 9
  local target=${1:-$(cat "$STATE/previous" 2>/dev/null || true)} cur img
  target=${target#prod-}
  [[ "$target" =~ ^[0-9a-f]{40}$ ]] || die "用法：sudo trading rollback [完整提交号]（没有记录上一个版本）"
  cur=$(current_rev)
  for img in "${IMAGES[@]}"; do pull "$REG/$img:$(img_tag "$target")"; done
  log "手动回滚：$cur → $target（数据库不回退；要回退数据由运维分步指导用备份恢复）"
  pull "$REG/trading-app:$TRACK" && revision "$REG/trading-app:$TRACK" > "$STATE/paused"
  switch_to "$(img_tag "$target")" > /dev/null 2>&1 || true
  if wait_healthy "$target"; then echo "$cur" > "$STATE/previous"; log "回滚成功：$target"; else log "回滚后 $target 没有通过健康检查，需要人工处理"; exit 1; fi
}

# mysqldump 的导出是否完整：两个库都在（--databases 会写 USE `库名`;）、最后一行是 "-- Dump completed"（mysqldump 出错中断时没有这一行）
dump_complete() {
  [ -s "$1" ] && dump_complete_stream < "$1"
}
# 同上，读标准输入（解密、解压后的数据流，磁盘上不落明文）
dump_complete_stream() {
  awk 'index($0, "USE `trading`;") == 1 { t = 1 } index($0, "USE `quote`;") == 1 { q = 1 } { last = $0 } END { exit !(t && q && last ~ /^-- Dump completed/) }'
}
# 备份加密的收件人：服务器自己的密钥，加上 Amos 的公钥（sudo trading backup-key，有就加）
age_recipients() {
  printf '%s\n' -R "$STATE/backup.pub"
  if [ -s "$STATE/backup-amos.pub" ]; then printf '%s\n' -R "$STATE/backup-amos.pub"; fi
}

# 临时文件只放在 /opt/trading/tmp（700，只有 root 能读），不放 /tmp；登记进 CLEAN_PATHS，脚本无论怎么退出都会删。
# 数据库导出在这里也只有加密后的（mysql.sql.gz.age），磁盘上不落明文（生产方案 07 页 R-4）
work_dir() {
  mkdir -p "$TR_DIR/tmp" && chmod 700 "$TR_DIR/tmp" && mktemp -d "$TR_DIR/tmp/$1-XXXXXX"
}
# 清掉上次被 kill -9 等打断留下的临时文件（超过 60 分钟的；正在用的不会这么老：导出最多 DUMP_TIMEOUT 秒、演练最多约 10 分钟）
sweep_stale() {
  if [ -d "$TR_DIR/tmp" ]; then find "$TR_DIR/tmp" -mindepth 1 -maxdepth 1 -mmin +60 -exec rm -rf {} + 2> /dev/null || true; fi
  find "$TR_DIR/backup" "$TR_DIR/backup/photos" -maxdepth 1 -name 'trading-*.tar.age.tmp' -mmin +60 -delete 2> /dev/null || true
  return 0
}

# 备份失败：原因写日志并打到标准错误（调用方常把标准输出丢掉），返回 1；临时文件由调用方删
backup_fail() {
  log "备份失败：$1" > /dev/null
  say "  ✗ 备份失败：$1" >&2
  return 1
}

# mysql 容器里残留的 mysqldump（外层超时只杀得掉本机的 docker 客户端，容器里的进程还会跑）：按进程名找出来杀掉，输出一句结果（写日志用）。
# 容器里没有 pkill，直接看 /proc；已经结束、只等回收的僵尸进程（容器的 1 号进程 mysqld 不回收）不占内存，不算
kill_container_dumps() {
  local n
  if [ -z "$(compose ps -q --status running mysql 2> /dev/null)" ]; then echo "mysql 容器没在运行，里面没有 mysqldump"; return 0; fi
  n=$(timeout -k 5 30 "${COMPOSE[@]}" exec -T mysql sh -c '
    live() { [ "$(cat "$1/comm" 2>/dev/null)" = mysqldump ] && ! grep -q "^State:.*Z" "$1/status" 2>/dev/null; }
    for p in /proc/[0-9]*; do live "$p" && kill -9 "${p#/proc/}" 2>/dev/null; done
    sleep 1; n=0
    for p in /proc/[0-9]*; do live "$p" && n=$((n + 1)); done
    echo "$n"' 2> /dev/null < /dev/null) || n=""
  case "$n" in
    0) echo "mysql 容器里没有还在跑的 mysqldump" ;;
    "") echo "进不了 mysql 容器查 mysqldump（30 秒没反应），需要人工看：sudo docker top trading-mysql-1" ;;
    *) echo "mysql 容器里还剩 $n 个 mysqldump 没杀掉，需要人工看：sudo docker top trading-mysql-1" ;;
  esac
}

# 数据库备份（不含证件照片）合计多少 MB
backup_total_mb() {
  local b
  b=$(find "$TR_DIR/backup" -maxdepth 1 -name 'trading-*.tar.age' -printf '%s\n' 2> /dev/null | awk '{ s += $1 } END { print s + 0 }')
  echo $(( (b + 1048575) / 1048576 ))
}

# 加密备份（生产方案 07 页 R-4）：两个库（mysqldump → gzip → age，磁盘上不落明文）、Redis 快照、.env 打成一个包，再整个经 age 加密写盘。
# 证件照片不进这个包（本机只有一块盘、不做异地，副本只防误删）：每周一次增量（photos_backup），sudo trading backup --with-photos 打包全部。
# 每一步都显式检查（不靠 set -e：调用方常写成 if cmd_backup …，那样 set -e 在函数里不生效）；任何一步失败都不留备份文件、返回 1。
# 写之前查空间：剩余 < 2 × 上次大小就不写、发邮件（不写半个文件）。
# 同一时间只做一份（backup.lock，默认最多等 6 分钟，trading off 里只等 2 分钟），每天的备份和更新前、off 时的备份不会同时导出
cmd_backup() {
  need_root
  [ -f "$STATE/backup.pub" ] || die "没有备份加密密钥（先运行 install）"
  local name=daily photos="" a
  for a in "$@"; do
    case "$a" in
      --with-photos) photos=full ;;
      -*) die "不认识的选项 $a（只有 --with-photos）" ;;
      *) name=$a ;;
    esac
  done
  [[ "$name" =~ ^[A-Za-z0-9_.-]{1,40}$ ]] || die "备份名字只能用字母、数字和 _.-"
  mkdir -p "$TR_DIR/backup/photos"
  local wait_s=${BACKUP_LOCK_WAIT:-360}
  exec 8> "$STATE/backup.lock"
  if ! flock -n 8; then
    say "  另一份备份正在做，最多等 $(dur "$wait_s")（不用操作）" >&2
    if ! run_bg flock -w "$wait_s" 8; then exec 8>&-; backup_fail "另一份备份 $(dur "$wait_s") 还没做完"; return 1; fi
  fi
  sweep_stale
  local rc=0
  backup_once "$name" || rc=$?
  # 证件照片：手动 --with-photos 打包全部；每天的备份顺带看一下，上次照片备份超过 7 天就做一次增量
  if [ "$rc" = 0 ]; then
    if [ -z "$photos" ] && [ "$name" = daily ] && [ $(( $(date +%s) - $(cat "$STATE/last-photos" 2> /dev/null || echo 0) )) -gt $((7 * 86400)) ]; then photos=incr; fi
    if [ -n "$photos" ]; then photos_backup "$photos" || rc=$?; fi
  fi
  exec 8>&-
  # 生产：每天的备份顺带每 30 天做一次恢复演练（生产方案 05 页第 3 节；不停 Trading，结果不影响备份的成败）
  if [ "$rc" = 0 ] && prod && [ "$name" = daily ] && [ $(( $(date +%s) - $(cat "$STATE/last-drill-at" 2> /dev/null || echo 0) )) -gt $((30 * 86400)) ]; then
    cmd_restore_drill > /dev/null || true
  fi
  return "$rc"
}

# 导出两个库 → 压缩 → 加密写到 $1（后台运行，见 run_bg；pipefail：任何一步失败都算失败）
dump_encrypted() {
  local recips=()
  mapfile -t recips < <(age_recipients)
  timeout -k 10 $((DUMP_TIMEOUT + 30)) "${COMPOSE[@]}" exec -T mysql \
    sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec timeout -k 10 "$1" mysqldump -uroot --single-transaction --quick --routines --triggers --set-gtid-purged=OFF --databases trading quote' \
    sh "$DUMP_TIMEOUT" < /dev/null | gzip -6 | age "${recips[@]}" > "$1"
}

backup_once() {
  local name=$1 f tmp need free size recips=()
  mapfile -t recips < <(age_recipients)
  # 写之前查空间（生产方案 03 页）：剩余要 ≥ 2 × 上次大小（还没有上次时按 64 MB 算）
  need=$(( 2 * $(last_backup_mb) )); [ "$need" -gt 0 ] || need=64
  free=$(disk_free_mb)
  if [ "$free" -lt "$need" ]; then
    mail_once disk-backup "磁盘不够，没有备份" "根分区只剩 ${free} MB，备份要 ≥ ${need} MB（2 × 上次备份），这次没有写（不留半个文件）。看 sudo trading status、sudo docker system df。" || true
    backup_fail "根分区只剩 ${free} MB，要 ≥ ${need} MB（2 × 上次备份），没有写"; return 1
  fi
  rm -f "$STATE/mailed-disk-backup"
  f="$TR_DIR/backup/trading-$(date -u +%Y%m%dT%H%M%SZ)-$name.tar.age"
  CLEAN_PATHS+=("$f.tmp")
  tmp=$(work_dir backup) || { backup_fail "建不了临时目录 $TR_DIR/tmp（磁盘满了？）"; return 1; }
  CLEAN_PATHS+=("$tmp")
  # 密码用容器里已有的环境变量，不出现在命令行；--quick（默认就开）逐行导出，不把整张表读进内存。
  # 超时放在容器里（timeout 杀得到容器里的 mysqldump）；外层再多 30 秒兜底（docker exec 本身卡住时）。
  # 导出直接压缩再加密（gzip -6，约小 5～10 倍），磁盘上只有加密后的 mysql.sql.gz.age；管道里任何一步失败（pipefail）都算失败
  DUMP_RUNNING=1
  if ! run_bg dump_encrypted "$tmp/mysql.sql.gz.age" < /dev/null; then
    DUMP_RUNNING=""
    log "备份：$(kill_container_dumps)" > /dev/null
    rm -rf "$tmp"
    backup_fail "mysqldump 没成功（退出码非 0 或超过 ${DUMP_TIMEOUT} 秒；常见原因：MySQL 内存顶到上限、没在运行）"; return 1
  fi
  DUMP_RUNNING=""
  # 完整性：解密、解压成数据流检查（不落盘）
  if ! age -d -i "$STATE/backup.key" "$tmp/mysql.sql.gz.age" | gzip -dc | dump_complete_stream; then
    rm -rf "$tmp"; backup_fail "mysqldump 的导出不完整（缺 trading 或 quote 库，或没有结尾的 Dump completed）"; return 1
  fi
  # Redis 只放限流计数和登录票据，丢了不影响数据：快照没做成只提醒，包里放上一次的快照（Redis 每 5 分钟自己存一次）。
  # 标准输入必须是 /dev/null（T-7，11/18 第一次 trading off）：在终端里运行时，timeout 把命令放进自己的后台进程组，
  # docker compose exec 默认转发标准输入，一读终端就收到 SIGTTIN 停住，60 秒后被杀；SAVE 本身不到 1 秒
  if ! timeout -k 5 60 "${COMPOSE[@]}" exec -T redis sh -c 'REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli SAVE | grep -q OK' < /dev/null; then
    log "备份提醒：Redis 快照没做成，包里是 Redis 上一次自己存的快照" > /dev/null
    say "  ⚠ Redis 快照没做成，包里是上一次的快照（只有限流计数和登录票据，不影响数据）" >&2
  fi
  local parts=(.env)
  if [ -f "$TR_DIR/data/redis/dump.rdb" ]; then parts+=(data/redis/dump.rdb); fi
  if ! tar -C "$TR_DIR" -cf - --transform 's|^data/redis/dump.rdb$|redis.rdb|' "${parts[@]}" -C "$tmp" mysql.sql.gz.age | age "${recips[@]}" > "$f.tmp"; then
    rm -rf "$tmp"; rm -f "$f.tmp"; backup_fail "打包或加密失败（磁盘满了？）"; return 1
  fi
  rm -rf "$tmp"
  if ! { [ -s "$f.tmp" ] && mv "$f.tmp" "$f" && chmod 600 "$f"; }; then rm -f "$f.tmp"; backup_fail "写不了备份文件"; return 1; fi
  size=$(stat -c %s "$f")
  # 保留 7 天；合计超过上限（测试 2 GB、生产 0.6 GB）从最旧的删；至少留 3 份
  find "$TR_DIR/backup" -maxdepth 1 -name 'trading-*.tar.age' -mtime +7 -print0 | while IFS= read -r -d '' old; do
    if [ "$(ls -1 "$TR_DIR/backup"/trading-*.tar.age | wc -l)" -gt 3 ]; then rm -f "$old"; fi
  done
  while [ "$(backup_total_mb)" -gt "$BACKUP_MAX_MB" ] && [ "$(ls -1 "$TR_DIR/backup"/trading-*.tar.age | wc -l)" -gt 3 ]; do
    rm -f "$(ls -1tr "$TR_DIR/backup"/trading-*.tar.age | head -1)"
  done
  date -u +%s > "$STATE/last-backup"
  echo "$size" > "$STATE/last-backup-size"
  log "备份完成：$(basename "$f")（$(du -h "$f" | cut -f1)，本机已加密）"
}

# 证件照片备份（生产方案 03 页）：incr = 上次照片备份以后新增、改过的文件（第一次就是全部），full = 全部。
# 放在 backup/photos/，不自动删（增量要连着用；本机副本只防误删、不防盘坏）；空间算进磁盘告警。没有要打包的文件就不写
photos_backup() {
  local kind=$1 f stamp started list n
  started=$(date +%s)
  stamp="$STATE/photos-stamp"
  list=$(work_dir photos) || { backup_fail "建不了临时目录"; return 1; }
  CLEAN_PATHS+=("$list")
  if [ "$kind" = incr ] && [ -f "$stamp" ]; then
    (cd "$TR_DIR" && find data/storage -type f -newer "$stamp" -print0) > "$list/files"
  else
    (cd "$TR_DIR" && find data/storage -type f -print0) > "$list/files"
  fi
  n=$(tr -cd '\0' < "$list/files" | wc -c)
  if [ "$n" -eq 0 ]; then
    rm -rf "$list"; date -u +%s > "$STATE/last-photos"; touch -d "@$started" "$stamp"
    log "证件照片备份（$kind）：没有新增的照片，不写" > /dev/null; return 0
  fi
  f="$TR_DIR/backup/photos/trading-photos-$(date -u +%Y%m%dT%H%M%SZ)-$kind.tar.age"
  CLEAN_PATHS+=("$f.tmp")
  local recips=()
  mapfile -t recips < <(age_recipients)
  if ! tar -C "$TR_DIR" --null -T "$list/files" -cf - | age "${recips[@]}" > "$f.tmp" || ! mv "$f.tmp" "$f"; then
    rm -rf "$list"; rm -f "$f.tmp"; backup_fail "证件照片打包或加密失败（磁盘满了？）"; return 1
  fi
  chmod 600 "$f"; rm -rf "$list"
  date -u +%s > "$STATE/last-photos"; touch -d "@$started" "$stamp"
  log "证件照片备份完成（$kind，$n 个文件）：$(basename "$f")（$(du -h "$f" | cut -f1)）"
}

# 把照片备份按时间顺序解回 data/storage：只补缺的文件，已有的不覆盖（误删了照片时用）
cmd_restore_photos() {
  need_root
  local f n=0
  # 文件名里是 UTC 时间，按名字排就是按时间
  for f in "$TR_DIR"/backup/photos/trading-photos-*.tar.age; do
    [ -e "$f" ] || continue
    age -d -i "$STATE/backup.key" "$f" | tar -C "$TR_DIR" --skip-old-files -xf - || die "解不开 $(basename "$f")"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || die "没有证件照片备份（backup/photos/ 是空的）"
  chown -R 10001 "$TR_DIR/data/storage"
  ok "从 $n 份照片备份里补回了缺的文件（已有的没动）"; log "restore-photos：$n 份"
}

# 备份另加 Amos 的公钥（生产方案 05 页第 2 节：私钥进 Amos 的密码管理器）。公钥不是密钥；off = 去掉
cmd_backup_key() {
  need_root
  local v=${1:-}
  if [ "$v" = off ]; then rm -f "$STATE/backup-amos.pub"; ok "已去掉 Amos 的公钥（以后的备份只用服务器自己的密钥）"; log "backup-key off"; return 0; fi
  [[ "$v" =~ ^age1[02-9ac-hj-np-z]{58}$ ]] || die "用法：sudo trading backup-key <age 公钥>（age1 开头的 62 位；Amos 用 age-keygen 生成，私钥只放密码管理器）| off"
  printf '%s\n' "$v" > "$STATE/backup-amos.pub"; chmod 600 "$STATE/backup-amos.pub"
  ok "已加上 Amos 的公钥：以后的备份 Amos 的私钥也能解开（已有的备份不变）"; log "backup-key 已设置"
}

# 备份包里的数据库导出解成 SQL 数据流（标准输出）：新格式是加密的 mysql.sql.gz.age（解密、解压都在管道里，磁盘上不落明文），
# 旧格式（R-4 以前）是明文 mysql.sql。用法：backup_sql <解开备份包的临时目录>
backup_sql() {
  if [ -f "$1/mysql.sql.gz.age" ]; then age -d -i "$STATE/backup.key" "$1/mysql.sql.gz.age" | gzip -dc; else cat "$1/mysql.sql"; fi
}
# 从备份包里取出数据库导出（新格式取加密的 mysql.sql.gz.age，旧格式取 mysql.sql）到临时目录
backup_extract() {
  local f=$1 dir=$2 member
  member=$(age -d -i "$STATE/backup.key" "$f" | tar -tf - | grep -m1 -xE 'mysql\.sql(\.gz\.age)?') || return 1
  age -d -i "$STATE/backup.key" "$f" | tar -C "$dir" -xf - "$member"
}

# 恢复演练（不碰正在运行的数据）：解密到临时目录 → 不联网的临时 MySQL → 导入 → 核对表数和行数 → 删临时文件和容器。
# 测试环境平时由 trading off 在 Trading 全停之后自动做（2 核 2G 上不和正在跑的 Trading 抢内存）；生产内存够，不停 Trading，
# 装好当天手动做一次、以后每天的备份顺带每 30 天做一次。结果记在 state/last-drill，status 显示。
# 每一步都有时间上限（等临时库就绪 DRILL_READY_TIMEOUT、导入 DRILL_IMPORT_TIMEOUT）；临时容器和明文 SQL 登记进退出清理，Ctrl-C、kill 也会删
cmd_restore_drill() {
  need_root
  local f tmp cid n_t n_q logs
  f=$(ls -1t "$TR_DIR"/backup/trading-*.tar.age 2>/dev/null | head -1)
  [ -n "$f" ] || { bad "还没有备份（先 sudo trading backup）"; return 1; }
  # 磁盘（生产方案 03 页）：剩余要 ≥ 4 × 备份大小 + 2 GB，不够就跳过、发邮件
  local dneed dfree
  dneed=$(( 4 * ( ($(stat -c %s "$f") + 1048575) / 1048576 ) + ${TR_DRILL_MIN_DISK_MB:-2048} )); dfree=$(disk_free_mb)
  if [ "$dfree" -lt "$dneed" ]; then
    bad "没做恢复演练：根分区剩 ${dfree} MB，演练要 ≥ ${dneed} MB（4 × 备份 + 2 GB）"; drill_result "跳过：磁盘不够（${dfree} < ${dneed} MB）"
    mail_once disk-drill "磁盘不够，没做恢复演练" "根分区剩 ${dfree} MB，恢复演练要 ≥ ${dneed} MB（4 × 备份 + 2 GB），这次跳过。" || true
    return 1
  fi
  rm -f "$STATE/mailed-disk-drill"
  sweep_stale
  tmp=$(work_dir drill) || { say "  ✗ 建不了临时目录 $TR_DIR/tmp（磁盘满了？）" >&2; drill_result "失败：建不了临时目录"; return 1; }
  CLEAN_PATHS+=("$tmp")
  if ! backup_extract "$f" "$tmp"; then
    rm -rf "$tmp"; drill_result "失败：解不开 $(basename "$f")"; bad "解密或解包失败：$(basename "$f")"; return 1
  fi
  # 只演练完整的导出（修复前的版本在 mysqldump 失败时也会留下备份文件）
  if ! backup_sql "$tmp" | dump_complete_stream; then
    rm -rf "$tmp"; drill_result "失败：$(basename "$f") 里的数据库导出不完整"
    bad "最新备份 $(basename "$f") 里的数据库导出不完整（当时 mysqldump 失败了），不能用来恢复：Trading 在跑时先 sudo trading backup 做一份新的"; return 1
  fi
  ok "解密：$(basename "$f")"
  docker rm -f trading-restore-drill > /dev/null 2>&1 || true
  # 内存：临时 MySQL 上限 DRILL_MEM_MB，可用内存要 ≥ DRILL_NEED_MB（测试 = 上限 + 64，生产 800）。
  # 测试环境 Trading 的应用在跑（手动运行时）就先停它们（数据库不停，演练完再启动）；生产内存够，不停。
  # 停之前拿自动更新的锁（不让 trading update 在演练中途把应用拉起来），并暂停内存守护（它看到可用内存低会把 Trading 全停）
  local need avail stopped=""
  need=$DRILL_NEED_MB
  if ! prod && [ -n "$(docker ps -q --filter label=com.docker.compose.project=trading --filter label=com.docker.compose.service=trading-app)" ]; then
    exec 7> "$STATE/update.lock"
    flock -n 7 || say "  自动更新正在进行，最多等 5 分钟（不用操作）"
    if ! flock -n 7 && ! run_bg flock -w 300 7; then
      exec 7>&-; rm -rf "$tmp"
      bad "自动更新正在进行（5 分钟没做完），这次不演练；等一会儿再运行，或 sudo trading off 时自动做"; drill_result "跳过：自动更新正在进行"; return 1
    fi
    DRILL_MEMGUARD_WAS_ON=""
    if [ -z "${TR_OFFLINE_TEST:-}" ] && systemctl is-active --quiet trading-memguard.timer; then DRILL_MEMGUARD_WAS_ON=1; systemctl stop trading-memguard.timer > /dev/null 2>&1 || true; fi
    say "  Trading 在跑：先停它的应用（trading-web、trading-app、quote-app），演练完再启动（以后让 sudo trading off 自动做更省事）"
    compose stop trading-web trading-app quote-app > /dev/null 2>&1 || true
    stopped=1
    DRILL_RESTART_PENDING=1
  fi
  avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
  if [ "$avail" -lt "$need" ]; then
    rm -rf "$tmp"; drill_restart_apps "$stopped"
    bad "没做恢复演练：可用内存 ${avail} MB，演练要 ≥ ${need} MB（临时数据库 ${DRILL_MEM_MB} MB + 余量 64 MB）。下次 sudo trading off 时会自动做"
    drill_result "跳过：内存不够（${avail} < ${need} MB）"; return 1
  fi
  say "  起临时数据库并导入（约 1–3 分钟；最多等 $((DRILL_READY_TIMEOUT + DRILL_IMPORT_TIMEOUT)) 秒）"
  CLEAN_CONTAINERS+=(trading-restore-drill)
  if ! cid=$(docker run -d --name trading-restore-drill --network none -e MYSQL_ALLOW_EMPTY_PASSWORD=yes --memory "${DRILL_MEM_MB}m" --memory-swap "${DRILL_MEM_MB}m" mysql:8.4 --innodb-buffer-pool-size=32M --performance-schema=OFF --max-connections=5 --temptable-max-ram=32M); then
    drill_cleanup "$tmp" "$stopped"; bad "临时数据库没起来（docker run 失败）"; drill_result "失败：临时数据库没起来"; return 1
  fi
  # 官方镜像初始化时先起一个不监听端口的临时进程，等到正式进程（port: 3306）就绪再导入（日志先存进变量再找，避免管道提前关闭）
  local waited=0 ready=""
  while [ "$waited" -lt "$DRILL_READY_TIMEOUT" ]; do
    logs=$(timeout 10 docker logs "$cid" 2>&1 || true)
    if grep -q 'ready for connections.*port: 3306' <<< "$logs"; then ready=1; break; fi
    sleep 2; waited=$((waited + 2))
  done
  if [ -z "$ready" ]; then
    drill_cleanup "$tmp" "$stopped"; bad "临时数据库 ${DRILL_READY_TIMEOUT} 秒还没就绪"; drill_result "失败：临时数据库 ${DRILL_READY_TIMEOUT} 秒没就绪"; return 1
  fi
  # 导入有时间上限：超时只杀得掉本机的 docker 客户端，所以紧接着删整个临时容器
  if ! run_bg drill_import "$tmp" "$cid"; then
    drill_cleanup "$tmp" "$stopped"
    bad "导入临时库失败或超过 ${DRILL_IMPORT_TIMEOUT} 秒"; drill_result "失败：导入 $(basename "$f") 出错或超时"; return 1
  fi
  n_t=$(timeout 30 docker exec "$cid" mysql -uroot -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='trading'" 2>/dev/null || echo 0)
  n_q=$(timeout 30 docker exec "$cid" mysql -uroot -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='quote'" 2>/dev/null || echo 0)
  local hist rc=0
  hist=$(timeout 30 docker exec "$cid" mysql -uroot -N -e "SELECT COUNT(*) FROM trading.flyway_schema_history WHERE success=1" 2>/dev/null || echo 0)
  drill_cleanup "$tmp" "$stopped"
  if [ "${n_t:-0}" -gt 10 ] && [ "${n_q:-0}" -gt 3 ] && [ "${hist:-0}" -gt 0 ]; then
    ok "导入临时库：trading $n_t 张表（迁移 $hist 条）、quote $n_q 张表"
    drill_result "通过：$(basename "$f")（trading $n_t 张表、quote $n_q 张表）"
  else
    bad "导入后表数不对：trading $n_t、quote $n_q、迁移记录 $hist"; drill_result "失败：$(basename "$f") 导入后表数不对"; rc=1
  fi
  return $rc
}

# 把备份里的数据库导入临时库（数据流，不落盘；有时间上限，后台运行，见 run_bg）
drill_import() { backup_sql "$1" | timeout -k 10 "$DRILL_IMPORT_TIMEOUT" docker exec -i "$2" mysql -uroot; }

# 演练结束（不管成败）：删临时容器和明文 SQL，停过 Trading 的应用就重新启动
drill_cleanup() {
  docker rm -f trading-restore-drill > /dev/null 2>&1 || true
  rm -rf "$1"
  drill_restart_apps "$2"
}

# 演练前停过 Trading 的应用（手动运行时）就重新启动，恢复内存守护，放开自动更新的锁
drill_restart_apps() {
  [ -n "$1" ] || return 0
  # compose up 忽略 HUP、INT（窗口断了也做完）；成功才清掉标记，没成功退出收尾会再拉一次
  if ( trap '' HUP INT; exec "${COMPOSE[@]}" up -d ) > /dev/null 2>&1; then DRILL_RESTART_PENDING=""; fi
  if wait_healthy "$(current_rev)"; then ok "Trading 的应用已重新启动"; else bad "Trading 的应用重新启动后没通过健康检查（sudo trading status）"; fi
  if [ -n "${DRILL_MEMGUARD_WAS_ON:-}" ]; then systemctl start trading-memguard.timer > /dev/null 2>&1 || true; DRILL_MEMGUARD_WAS_ON=""; fi
  exec 7>&-
}

# 记下最近一次恢复演练的结果（status 显示），也写日志
drill_result() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" > "$STATE/last-drill"; date -u +%s > "$STATE/last-drill-at"; log "恢复演练$1" > /dev/null; }

# 真恢复（生产方案 05 页第 3 节）：sudo trading restore <备份文件> --confirm [--production]（生产必须写 --production）。
# 先检查备份能解开、导出完整 → 拿自动更新的锁、停定时器 → 先把现在的数据再备份一次（失败就什么都不动）→ 停应用 → 删掉两个库、导入备份 →
# 暂停把提现交给 TopUP（payment.payout.paused = true：备份之后已经交给 TopUP 的提现在库里会变回"已审核待放款"，再交就重复付款）→ 起应用、开定时器。
# 只恢复两个库；.env（密钥）、证件照片（restore-photos）、Redis（只有计数和票据）不动。导入失败时应用保持停着，按提示用刚做的那份备份恢复回去
cmd_restore() {
  need_root
  local f="" confirm="" production="" a
  for a in "$@"; do
    case "$a" in
      --confirm) confirm=1 ;;
      --production) production=1 ;;
      -*) die "不认识的选项 $a" ;;
      *) f=$a ;;
    esac
  done
  [ -n "$f" ] || die "用法：sudo trading restore <备份文件> --confirm$(prod && echo " --production")（备份文件在 $TR_DIR/backup/，sudo ls -lt $TR_DIR/backup）"
  [ -f "$f" ] || f="$TR_DIR/backup/$f"
  [ -f "$f" ] || die "找不到备份文件 $f"
  if prod && [ -z "$production" ]; then die "这是生产：恢复会把两个库换成备份里的，备份之后的交易和资金记录都没了。确定要做就加 --confirm --production"; fi
  if ! prod && [ -n "$production" ]; then die "这台不是生产（.env 没有 TR_ENV=production），不能写 --production"; fi
  [ -n "$confirm" ] || die "恢复会把两个库换成备份里的（备份之后的数据都没了）。确定要做就加 --confirm"
  [ -n "$(compose ps -q --status running mysql 2> /dev/null)" ] || die "MySQL 没在运行：先 sudo trading on"
  exec 9> "$STATE/update.lock"
  flock -n 9 || { say "  自动更新正在进行，最多等 5 分钟（不用操作）"; run_bg flock -w 300 9 || die "自动更新 5 分钟还没做完，什么都没动，过几分钟再运行"; }
  sweep_stale
  local tmp
  tmp=$(work_dir restore) || die "建不了临时目录 $TR_DIR/tmp（磁盘满了？）"
  CLEAN_PATHS+=("$tmp")
  say "== 1/5 检查备份 $(basename "$f")（解密、导出完整）"
  backup_extract "$f" "$tmp" || die "解不开 $(basename "$f")（不是这台服务器的备份，或文件坏了），什么都没动"
  backup_sql "$tmp" | dump_complete_stream || die "$(basename "$f") 里的数据库导出不完整，不能用来恢复，什么都没动"
  ok "备份能解开、导出完整"
  say "== 2/5 先把现在的数据备份一次（恢复错了可以换回来）"
  sysctl_ disable --now trading-deploy.timer trading-backup.timer > /dev/null 2>&1 || true
  RESTORE_STAGE=before
  if ! cmd_backup before-restore > /dev/null; then
    sysctl_ enable --now trading-deploy.timer trading-backup.timer > /dev/null 2>&1 || true; RESTORE_STAGE=""
    die "现在的数据没备份成（原因见上面），什么都没动"
  fi
  local saved; saved=$(ls -1t "$TR_DIR"/backup/trading-*-before-restore.tar.age | head -1)
  ok "已备份：$(basename "$saved")"
  say "== 3/5 停应用（MySQL、Redis 不停）"
  compose stop trading-web trading-app quote-app > /dev/null 2>&1 || true
  RESTORE_STAGE=stopped
  say "== 4/5 导入（删掉 trading、quote 两个库再导入；约 1–5 分钟）"
  RESTORE_STAGE=importing
  if ! run_bg restore_import "$tmp"; then
    RESTORE_STAGE=failed
    die "导入失败：应用保持停着。用刚做的备份换回来：sudo trading restore $(basename "$saved") --confirm$(prod && echo " --production")，截图给主会话"
  fi
  # 暂停把提现交给 TopUP（应用读系统配置 payment.payout.paused）；状态里也记一笔
  if ! timeout 30 "${COMPOSE[@]}" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot -e "INSERT INTO trading.common_config (config_key, value) VALUES (\"payment.payout.paused\", \"true\") ON DUPLICATE KEY UPDATE value = \"true\""' < /dev/null > /dev/null 2>&1; then
    RESTORE_STAGE=failed
    die "数据已导入，但没能暂停提现交给 TopUP：应用保持停着（不然可能重复付款），截图给主会话"
  fi
  date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/payout-paused"
  ok "已导入；提现暂停交给 TopUP"
  RESTORE_STAGE=""
  say "== 5/5 起应用、开定时器"
  compose up -d > /dev/null 2>&1 || true
  if wait_healthy "$(current_rev)"; then ok "Trading 已启动，健康检查通过"; else bad "应用 3 分钟内没通过健康检查（sudo trading status 截图给主会话）"; fi
  sysctl_ enable --now "${TIMERS[@]}" > /dev/null 2>&1 || true
  log "restore：$(basename "$f")（恢复前的数据在 $(basename "$saved")）；提现暂停交给 TopUP"
  say "下一步：在 TopUP 后台逐笔核对备份时间之后交过的提现（Trading 里变回\"已审核待放款\"的那些），核对完 sudo trading start-payout --confirm"
}
# 删掉两个库、导入备份（数据流，不落盘；后台运行，见 run_bg）。mysqldump --databases 的导出里有 CREATE DATABASE，账号和授权在 mysql 库里不受影响
restore_import() {
  timeout 60 "${COMPOSE[@]}" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot -e "DROP DATABASE IF EXISTS trading; DROP DATABASE IF EXISTS quote;"' < /dev/null
  backup_sql "$1" | timeout -k 10 1800 "${COMPOSE[@]}" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot'
}

# 恢复数据后，人工在 TopUP 后台核对完：恢复把提现交给 TopUP（payment.payout.paused = false，应用 5 秒内读到）
cmd_start_payout() {
  need_root
  [ "${1:-}" = --confirm ] || die "确认已经在 TopUP 后台核对过恢复之后变回\"已审核待放款\"的提现（不会重复付款）后，运行 sudo trading start-payout --confirm"
  [ -n "$(compose ps -q --status running mysql 2> /dev/null)" ] || die "MySQL 没在运行：先 sudo trading on"
  timeout 30 "${COMPOSE[@]}" exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot -e "UPDATE trading.common_config SET value = \"false\" WHERE config_key = \"payment.payout.paused\""' < /dev/null > /dev/null 2>&1 \
    || die "没改成（MySQL 30 秒没回应？），截图给主会话"
  rm -f "$STATE/payout-paused"
  ok "提现恢复交给 TopUP（应用 5 秒内生效）"; log "start-payout：恢复提现交给 TopUP"
}

cmd_test_mail() { need_root; send_mail "测试邮件" "这是 Trading $(env_name)的测试邮件（$(date -u +%Y-%m-%dT%H:%M:%SZ)）。收到说明邮件设置正确。" && ok "已发出，请查收\"[测试] Trading 测试邮件\"" || { bad "没发出去（邮件没配好，看 $LOGF）"; return 1; }; }

# 每 5 分钟检查，只在状态变化时发邮件（恢复时再发一封）
cmd_watch() {
  need_root
  local problems=()
  # 轮流模式：Trading 停着（trading off，或者 TopUP 启动时按约定停了 trading-deploy 定时器）：不检查、不告警，顺手把自己也停了。
  # 独立模式没有 TopUP 来停它，定时器停着就是不正常（trading off 会连 watch 一起停，不会走到这里）：照常检查，并记一条问题
  if ! share_topup && [ -z "${TR_OFFLINE_TEST:-}" ] && ! systemctl is-active --quiet trading-deploy.timer; then
    problems+=("自动更新定时器 trading-deploy 停着（独立模式下不该停；sudo trading on 会打开）")
  elif [ -z "${TR_OFFLINE_TEST:-}" ] && ! systemctl is-active --quiet trading-deploy.timer; then
    systemctl disable --now trading-watch.timer > /dev/null 2>&1 || true
    log "trading-deploy 定时器停着（Trading 轮到 TopUP 用机器），检查暂停"; return 0
  fi
  local body avail disk free last exp_s now prev_run
  body=$(health)
  [ "$(health_field status "$body")" = UP ] || problems+=("trading-app 没响应或不健康")
  quote_healthy || problems+=("quote-app 不健康")
  [ -s "$STATE/skip" ] && problems+=("有版本被跳过：$(cut -c1-12 "$STATE/skip")")
  disk=$(disk_used_pct); free=$(disk_free_mb)
  if prod; then
    # 生产（生产方案 03 页）：已用 ≥ 80% 或剩 < 2 GB；可用内存 < 300 MB
    { [ "$disk" -ge 80 ] || [ "$free" -lt 2048 ]; } && problems+=("磁盘已用 ${disk}%、剩 ${free} MB（告警线 80% 或 2 GB）")
    avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo); [ "$avail" -lt 300 ] && problems+=("可用内存只剩 ${avail} MB")
  else
    [ "$disk" -ge 85 ] && problems+=("磁盘已用 ${disk}%")
    avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo); [ "$avail" -lt 200 ] && problems+=("可用内存只剩 ${avail} MB")
  fi
  now=$(date +%s); last=$(cat "$STATE/last-backup" 2>/dev/null || echo 0)
  [ $((now - last)) -gt $((26 * 3600)) ] && problems+=("超过 26 小时没有备份")
  # 备份要加密：备份目录里不能有没加密的文件
  [ -z "$(find "$TR_DIR/backup" -maxdepth 2 -type f ! -name '*.age' ! -name '*.age.tmp' 2> /dev/null | head -1)" ] || problems+=("备份目录里有没加密的文件")
  if prod; then
    # 虚拟机休眠（P-1：生产必须 24 小时常开）：这个检查每 5 分钟跑一次，和上一次隔了 15 分钟以上说明这段时间机器没在跑（休眠过或宕过）
    prev_run=$(cat "$STATE/watch-last-run" 2> /dev/null || echo "$now")
    [ $((now - prev_run)) -le 900 ] || problems+=("上一次检查是 $(((now - prev_run) / 60)) 分钟前（虚拟机可能休眠或宕过；生产必须常开）")
    echo "$now" > "$STATE/watch-last-run"
    [ ! -f "$STATE/payout-paused" ] || problems+=("提现暂停交给 TopUP（恢复数据后）：核对后 sudo trading start-payout --confirm")
    grep -Eq '^(FX_E2E_ENABLED|SPRING_PROFILES_ACTIVE|TRADING_E2E_ENABLED)=' "$ENVF" 2> /dev/null && problems+=(".env 里有端到端测试变量（FX_E2E_ENABLED 等）")
  else
    exp_s=$(date -d "$(openssl x509 -enddate -noout -in /etc/letsencrypt/live/trading/fullchain.pem 2>/dev/null | cut -d= -f2)" +%s 2>/dev/null || echo 0)
    [ $((exp_s - now)) -lt $((14 * 86400)) ] && problems+=("证书 14 天内到期或读不到")
  fi
  local c restarts oom
  oom=$(oom_24h || echo 未知)
  # 次数写进告警内容：再被杀一次内容就变，会再发一封；24 小时后没有新的就自动算恢复
  if [ "$oom" = 未知 ]; then
    problems+=("Docker 没回应，查不到容器有没有被内核按内存超限杀掉")
  elif [ -n "$oom" ]; then
    problems+=("24 小时内容器内存超限被内核杀掉：$oom（看 sudo trading mem）")
  fi
  for c in trading-app quote-app trading-web mysql redis; do
    restarts=$(docker inspect --format '{{.RestartCount}}' "trading-$c-1" 2>/dev/null || echo 0)
    [ "${restarts:-0}" -ge 3 ] && problems+=("$c 反复重启（$restarts 次）")
  done
  if [ -n "$(envget TEST_ADMIN_TOKEN_SHA256)" ] && [ "$(health_field env "$body")" != test ]; then problems+=("不是测试环境却有测试管理员（TEST_ADMIN_TOKEN_SHA256）"); fi
  local now_state prev_state
  now_state=$(printf '%s\n' "${problems[@]:-}" | sort)
  prev_state=$(cat "$STATE/watch" 2>/dev/null || true)
  [ "$now_state" = "$prev_state" ] && return 0
  printf '%s' "$now_state" > "$STATE/watch"
  if [ -n "$now_state" ]; then
    send_mail "告警：${problems[0]}" "$(printf '%s检查发现：\n%s\n\n看 sudo trading status。' "$(env_name)" "$now_state")" || true
  else
    send_mail "已恢复" "$(env_name)检查全部正常。" || true
  fi
}

cmd_gen_test_admin() {
  need_root
  prod && die "生产一律不设测试管理员（只给测试环境）"
  need_tty
  [ "$(health_field env "$(health)")" = test ] || die "健康检查的 env 不是 test：测试管理员只能在测试环境用，生产一律不设"
  setup_test_admin
}

cmd_test_admin_off() {
  need_root
  envdel TEST_ADMIN_TOKEN_SHA256
  apply > /dev/null || true
  ok "测试管理员已关，旧令牌立刻作废"; log "测试管理员已关"
}

# 内存守护：Trading 在跑、可用内存低于阈值时，只停 Trading（先停自动更新，再停全部容器，数据保留），记日志、发邮件；
# 不碰 TopUP 的任何容器。恢复：查清原因后 sudo trading on（它会重新检查可用内存）
cmd_memguard() {
  need_root
  [ -n "$(docker ps -q --filter label=com.docker.compose.project=trading 2>/dev/null || true)" ] || return 0
  local avail
  avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
  [ "$avail" -lt "$MEMGUARD_MB" ] || return 0
  log "内存守护：可用内存只剩 ${avail} MB（低于 ${MEMGUARD_MB} MB），停 Trading（不碰 TopUP）"
  sysctl_ disable --now trading-deploy.timer trading-backup.timer trading-watch.timer > /dev/null 2>&1 || true
  compose stop > /dev/null 2>&1 || true
  date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/memguard-stopped"
  send_mail "内存守护已停 Trading" "可用内存只剩 ${avail} MB（低于 ${MEMGUARD_MB} MB），已停 Trading 的全部容器和自动更新，数据保留；TopUP 没动。查清原因后运行 sudo trading on。" || true
}

# 停 TopUP（调它自己的 topup stop，按它的顺序：停定时器 → 停应用 → 备份 → 停数据库），确认 80/443 空出来、可用内存够
stop_topup_and_check_mem() {
  # 生产：和 TopUP 生产共存，从不停它；TopUP 在跑照常启动（生产方案 02 页第 5 节）
  if prod; then check_ports_mem; return; fi
  if ! share_topup; then
    # 独立模式：不调 topup stop。TopUP 的容器要是还在跑，说明还没搬干净，不替它停、也不启动 Trading
    if topup_running; then bad "独立模式（不碰 TopUP），但这台机器上 TopUP 的容器还在跑：Trading 不启动。要轮流用就先 sudo trading set TR_SHARE_WITH_TOPUP true"; return 1; fi
    check_ports_mem; return
  fi
  if topup_running; then
    [ -x "$TOPUP_BIN" ] || { bad "TopUP 的容器在跑，但找不到 $TOPUP_BIN"; return 1; }
    say "  停 TopUP（topup stop，数据保留；约 1～2 分钟）"
    "$TOPUP_BIN" stop > /dev/null 2>&1 7>&- 8>&- 9>&- || { bad "topup stop 没成功（看 sudo topup status），Trading 不启动"; return 1; }
  fi
  topup_running && { bad "TopUP 的容器还在跑，Trading 不启动"; return 1; }
  check_ports_mem
}

# 80/443 空着（或者就是 Trading 自己的 Nginx）、可用内存够；不够时轮流模式恢复 TopUP（独立模式 restart_topup 什么也不做）
check_ports_mem() {
  local p ports=(80 443)
  # 生产：8082～8085（Nginx）、127.0.0.1:18080（健康检查口）；Trading 自己的容器在跑时占着是正常的
  prod && ports=(8082 8083 8084 8085 18080)
  for p in "${ports[@]}"; do
    if port_busy "$p" && ! trading_running; then bad "$p 端口还被别的程序占着，Trading 不启动"; restart_topup; return 1; fi
  done
  local avail
  avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
  if [ -z "$(docker ps -q --filter label=com.docker.compose.project=trading 2>/dev/null || true)" ] && [ "$avail" -lt "$MIN_MEM_MB" ]; then
    bad "可用内存 ${avail} MB，少于 ${MIN_MEM_MB} MB（差 $((MIN_MEM_MB - avail)) MB），Trading 不启动$(share_topup && echo "；已恢复 TopUP")"
    restart_topup; return 1
  fi
  if share_topup; then ok "TopUP 已停、80/443 空着、可用内存 ${avail} MB（要 ≥ ${MIN_MEM_MB} MB）"; else ok "${ports[*]} 空着、可用内存 ${avail} MB（要 ≥ ${MIN_MEM_MB} MB）"; fi
}

# 启动 TopUP。topup start 忽略 HUP、INT（窗口断了、Ctrl-C 都不会把它打断在半路；被忽略的信号它改不回来）；
# 成功后写标记文件 state/topup-started.<进程号>，退出收尾看这个文件决定要不要再启动一次。
# 不把锁的文件描述符带给 TopUP（它起的进程要是一直在，锁就一直放不掉）
restart_topup() {
  # 独立模式一律不启动 TopUP（旧的 topup 命令还在也不碰）
  share_topup || return 0
  [ -x "$TOPUP_BIN" ] || return 0
  local mark="$STATE/topup-started.$$"
  rm -f "$mark"
  say "  启动 TopUP（topup start，它自己再查内存和健康检查）"
  if ( trap '' HUP INT; "$TOPUP_BIN" start > /dev/null 2>&1 7>&- 8>&- 9>&- && : > "$mark" ); then
    ok "TopUP 已启动"; log "TopUP 已启动（topup start）" > /dev/null
  else
    bad "topup start 没成功（看 sudo topup status，截图给主会话）"; log "topup start 没成功" > /dev/null; return 1
  fi
}

cmd_on() {
  need_root
  [ -f "$ENVF" ] && [ -n "$(current_tag)" ] || die "还没部署过，先运行 sudo trading install …"
  if share_topup; then say "== 切到 Trading（TopUP 停下）"; else say "== 启动 Trading（$(solo_name)，不碰 TopUP）"; fi
  # 上次演练被 kill -9 打断时可能留下的临时库（320 MB），先删，免得占着内存
  docker rm -f trading-restore-drill > /dev/null 2>&1 || true
  stop_topup_and_check_mem || exit 1
  guard_env
  compose up -d > /dev/null 2>&1
  if wait_healthy "$(current_rev)"; then ok "Trading 已启动，健康检查通过"; else bad "Trading 3 分钟内没通过健康检查（sudo trading status 截图给主会话）"; fi
  sysctl_ enable --now "${TIMERS[@]}" > /dev/null 2>&1 && ok "定时器已打开（含内存守护）"
  rm -f "$STATE/memguard-stopped"
  log "trading on"
}

# trading off 被打断（或备份失败）而 Trading 还没全停时：按原样恢复 Trading、打开定时器（TopUP 不启动）
off_restore_trading() {
  compose up -d > /dev/null 2>&1 || true
  sysctl_ enable --now "${TIMERS[@]}" > /dev/null 2>&1 || true
}

# 最坏情况（自动更新正在跑 5 分钟 + 等另一份备份 2 分钟 + 导出 5.5 分钟 + 停容器约 2 分钟 + 恢复演练 8 分钟 + topup start）约 25 分钟，
# 正常 2–5 分钟。要在"远程连接"的终端里运行；用"云助手 → 执行命令"时超时要设 ≥ 30 分钟。中途窗口断了也会按上面的规则收尾（on_exit）
cmd_off() {
  need_root
  if share_topup; then say "== 切回 TopUP（Trading 停下，数据保留；一般 2–5 分钟）"; else say "== 停 Trading（$(solo_name)：备份、恢复演练，不启动 TopUP；数据保留，一般 2–5 分钟）"; fi
  # 以前的进程留下的启动标记（进程号可能被重用）先删
  rm -f "$STATE"/topup-started.*
  # 上次演练被 kill -9 打断时可能留下的临时库（320 MB），先删
  docker rm -f trading-restore-drill > /dev/null 2>&1 || true
  # 先拿和 trading update 同一把锁、再停定时器：等锁时被打断，Trading 和定时器都还是原样；拿到锁以后自动更新也不会再把 Trading 拉起来
  exec 9> "$STATE/update.lock"
  if ! flock -n 9; then
    say "  自动更新正在进行，最多等 $(dur "$OFF_LOCK_WAIT")（不用操作）"
    if ! run_bg flock -w "$OFF_LOCK_WAIT" 9; then
      bad "自动更新 $(dur "$OFF_LOCK_WAIT") 还没做完，这次没切换：Trading 照常跑、定时器没动、TopUP 不启动。过几分钟再运行 sudo trading off"
      exit 1
    fi
  fi
  local running=""
  [ -n "$(docker ps -q --filter label=com.docker.compose.project=trading)" ] && running=1
  # 从这里到数据库停下之前被打断（或备份失败）：按原样恢复 Trading、打开定时器（on_exit）
  [ -z "$running" ] || OFF_RESTORE_TRADING=1
  sysctl_ disable --now "${TIMERS[@]}" > /dev/null 2>&1 || true
  ok "定时器已停"
  if [ -n "$running" ]; then
    compose stop trading-web trading-app quote-app > /dev/null 2>&1 || true
    ok "应用已停"
    if BACKUP_LOCK_WAIT=120 cmd_backup before-off > /dev/null; then ok "备份完成"; else bad "备份失败：Trading 按原样恢复，TopUP 不启动"; exit 1; fi
    compose stop > /dev/null 2>&1 || true
    # 从这里起 Trading 全停了：轮流模式下不管后面演练成败、被 Ctrl-C、窗口断了还是 kill，退出时都启动 TopUP（on_exit）；独立模式不启动
    OFF_RESTORE_TRADING=""; if share_topup; then OFF_START_TOPUP=1; fi
    ok "MySQL、Redis 已停"
    # 恢复演练放在这里：Trading 全停了、TopUP 还没启动，2 核 2G 的内存够起临时数据库；只用刚才成功的那份备份（备份失败上面已经退出）
    say "  恢复演练（用刚做的备份，约 1–3 分钟$(share_topup && echo "；不通过也照样切回 TopUP")）"
    if cmd_restore_drill; then ok "恢复演练通过"; else bad "恢复演练没通过（备份文件还在；看 sudo trading status 和 $LOGF，截图给主会话）"; fi
  else
    ok "Trading 本来就停着"
  fi
  log "trading off（$(mode_name)）"
  if ! share_topup; then ok "Trading 已全停（$(solo_name)，没有启动 TopUP）"; return 0; fi
  # 启动成功才清掉"要启动 TopUP"的标记：没成功（或启动中被打断）时退出收尾会再启动一次
  if restart_topup; then OFF_START_TOPUP=""; else OFF_TOPUP_FIRST_FAILED=1; say "  退出前再试一次 topup start"; fi
}

main() {
  local c=${1:-help}; shift || true
  check_env
  mode_defaults
  case "$c" in
    install) cmd_install "$@" ;;
    setup) cmd_setup ;;
    on) cmd_on ;;
    off) cmd_off ;;
    keys) cmd_keys "$@" ;;
    set) cmd_set "$@" ;;
    set-key) cmd_set_key "$@" ;;
    status) need_root; cmd_status ;;
    mem) need_root; cmd_mem ;;
    update) cmd_update ;;
    retry) cmd_retry ;;
    rollback) cmd_rollback "$@" ;;
    backup) cmd_backup "$@" ;;
    restore-drill) cmd_restore_drill ;;
    restore) cmd_restore "$@" ;;
    restore-photos) cmd_restore_photos ;;
    start-payout) cmd_start_payout "$@" ;;
    backup-key) cmd_backup_key "$@" ;;
    test-mail) cmd_test_mail ;;
    watch) cmd_watch ;;
    memguard) cmd_memguard ;;
    gen-test-admin) cmd_gen_test_admin ;;
    test-admin-off) cmd_test_admin_off ;;
    *) sed -n '2,46p' "$0" | sed 's/^# \{0,1\}//' ;;
  esac
}
main "$@"
