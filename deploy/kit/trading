# 磁盘：根分区剩多少 MB、用了百分之几（/opt/trading 和 Docker 都在根分区上）
disk_free_mb() { df -Pm "${TR_DISK_PATH:-/}" | awk 'NR==2{print $4}'; }
disk_used_pct() { df -P "${TR_DISK_PATH:-/}" | awk 'NR==2{gsub("%","",$5); print $5}'; }
# 上一份数据库备份多大（MB，向上取整；没有记录时 0）
last_backup_mb() { local b; b=$(cat "$STATE/last-backup-size" 2> /dev/null || echo 0); echo $(( (b + 1048575) / 1048576 )); }

# 生产一次性安装（生产方案 v1 06 页第 6 步）：不问问题、不涉及密钥；可以重复运行。和测试环境的不同：
# 不装 certbot、不申请证书、不占 80/443；剩余磁盘 < 4 GB 不装；可用内存 < 2,600 MB 不启动；从不停 TopUP（同机的 TopUP 生产照常跑）；
# 跟 production 标签；备份每天 UTC 18:10（和 TopUP 的 19:40 错开）
cmd_install_production() {
  need_root
  [ $# -ge 3 ] && [ $# -le 4 ] || die "用法：sudo trading install --production <客户端主机名> <后台主机名> <官网主机名> [报价主机名]（平台给 8082、8083、8084、8085 的地址，不带 https://；填密钥用 sudo trading setup）"
  local app=$1 admin=$2 www=$3 quote=${4:-} d have
  # 报价主机名没写：按平台的规律从客户端的推出来（8082-<编号>… → 8085-<编号>…，推断；8085 先不发布，只用作转给报价服务的 Host）
  if [ -z "$quote" ]; then
    [[ "$app" =~ ^8082-(.+)$ ]] || die "客户端主机名不是 8082-<编号>… 的样子，推不出报价主机名：把第四个参数（8085 的主机名）也写上"
    quote="8085-${BASH_REMATCH[1]}"
  fi
  for d in "$app" "$admin" "$www" ${quote:+"$quote"}; do [[ "$d" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || die "主机名格式不对：$d（只写主机名，例如 8082-xxxx.instabox.tech，不带 https://）"; done
  mkdir -p "$TR_DIR/logs" "$STATE"
  if [ -f "$ENVF" ]; then
    have=$(envget TR_ENV)
    [ "$have" = production ] || [ -z "$(current_tag)" ] || die "这台机器上已经装了 Trading 测试环境（.env 没有 TR_ENV=production）：环境装好后不能改，什么都没动"
  fi
  INSTALL_HINT=1
  say "== Trading 生产第一次部署（可以重复运行；每步 ✓ / ✗，最后打印摘要，不显示任何密钥）"

  say "== 1/8 检查系统、磁盘、端口和内存（不碰 TopUP）"
  . /etc/os-release
  [ "${VERSION_ID:-}" = 24.04 ] && ok "Ubuntu 24.04" || bad "本脚本按 Ubuntu 24.04 写，这台是 ${PRETTY_NAME:-未知}（继续，出错截图）"
  local free; free=$(disk_free_mb)
  [ "$free" -ge "${TR_INSTALL_MIN_DISK_MB:-4096}" ] || die "根分区只剩 ${free} MB，生产要剩 ≥ 4 GB 才装（生产方案 03 页）。先看 sudo docker system df，截图给主会话"
  ok "根分区剩 ${free} MB（要 ≥ ${TR_INSTALL_MIN_DISK_MB:-4096}）"

  say "== 2/8 安装 Docker（已有就不动）、age（备份加密）、jq"
  export DEBIAN_FRONTEND=noninteractive
  if ! command -v docker > /dev/null || ! docker compose version > /dev/null 2>&1 || ! command -v age > /dev/null || ! command -v jq > /dev/null; then
    apt-get update -q > /dev/null
    if command -v docker > /dev/null; then apt-get install -y -q age jq curl unattended-upgrades > /dev/null
    else apt-get install -y -q docker.io docker-compose-v2 age jq curl unattended-upgrades > /dev/null; fi
  fi
  # 已有 daemon.json（TopUP 装过）就不动它、不重启 Docker（TopUP 生产在跑）；开发机演练（TR_OFFLINE_TEST）不动
  if [ ! -f /etc/docker/daemon.json ] && [ -z "${TR_OFFLINE_TEST:-}" ]; then
    mkdir -p /etc/docker
    printf '{ "log-driver": "json-file", "log-opts": { "max-size": "20m", "max-file": "3" } }\n' > /etc/docker/daemon.json
    systemctl restart docker
  fi
  systemctl enable --now docker > /dev/null 2>&1 || true
  ok "$(docker --version)"; ok "$(docker compose version)"; ok "age $(age --version)"

  say "== 3/8 目录和 .env（只有 root 能读），环境定为生产（之后不能改）"
  mkdir -p "$TR_DIR"/{data/mysql,data/redis,data/storage,backup,backup/photos,state,logs}
  chown -R 10001 "$TR_DIR/data/storage"
  chmod 700 "$TR_DIR/backup" "$TR_DIR/state"
  [ -f "$ENVF" ] || cp "$TR_DIR/.env.example" "$ENVF"
  chmod 600 "$ENVF"
  envset TR_ENV production
  mode_defaults
  [ -f "$STATE/image.env" ] || : > "$STATE/image.env"
  guard_env
  [ -n "${TR_OFFLINE_TEST:-}" ] || ln -sf "$TR_DIR/trading" /usr/local/bin/trading
  ok "$TR_DIR（TR_ENV=production）"
  stop_topup_and_check_mem || exit 1

  say "== 4/8 平台主机名（不是密钥）"
  envset APP_DOMAIN "$app"; envset ADMIN_DOMAIN "$admin"; envset WWW_DOMAIN "$www"; envset QUOTE_DOMAIN "$quote"
  # 浏览器推送的联系方式：没有就先用客户端地址（setup 的邮件一步会换成 mailto:告警邮箱）；三项缺一项健康检查就是 DOWN
  [ -n "$(envget FX_PUSH_VAPID_SUBJECT)" ] || envset FX_PUSH_VAPID_SUBJECT "https://$app"
  ok "客户端 $app、后台 $admin、官网 $www、报价 $quote（8085 先不发布）"

  say "== 5/8 生成内部密码和 Key（生产专用一套，写进 .env，不显示）"
  gen_secrets

  say "== 6/8 启动 production 最新版本（第一次要下载镜像，约 3–5 分钟）"
  if ! pull "$REG/trading-app:production"; then
    die "拉不到镜像 $REG/trading-app:production：要先合并到 main、Amos 在 GitHub 批准第一次 promote-production（生产方案 06 页第 5 步）"
  fi
  TR_FIRST=1 cmd_update || die "启动失败，看 $LOGF；改好后再运行同一条命令"

  say "== 7/8 打开定时器（每分钟更新、每天 UTC 18:10 备份、每 5 分钟检查、每 30 秒内存守护）"
  [ -n "${TR_OFFLINE_TEST:-}" ] || install_units
  sysctl_ enable --now "${TIMERS[@]}" > /dev/null 2>&1 && ok "定时器已打开"
  if [ -z "$(ls -A "$TR_DIR/backup"/trading-*.tar.age 2> /dev/null)" ]; then
    if cmd_backup first > /dev/null; then ok "第一份备份"; else bad "第一份备份没做成（原因见上面一行；之后每天自动备份，也可以 sudo trading backup）"; fi
  fi

  say "== 8/8 摘要（没有任何密钥）"
  cmd_status
  say "下一步（在虚拟机终端里）：sudo trading setup（中文向导：邮件沿用同机 TopUP 生产、后台初始密码、TopUP 生产商户 Key / Secret）。"
}

# 内部密码和 Key（install 用；已有的不改）
gen_secrets() {
  set_if_empty MYSQL_ROOT_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_DB_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_QUOTE_DB_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_REDIS_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_QUOTE_INTERNAL_KEY "$(rand_hex 32)"
  set_if_empty FX_QUOTE_KEY_ENC_KEY "$(rand_hex 32)"
  if [ -z "$(envget FX_PUSH_VAPID_PRIVATE_KEY)" ]; then
    local key pub priv
    key=$(mktemp)
    openssl ecparam -name prime256v1 -genkey -noout -out "$key" 2> /dev/null
    priv=$(openssl ec -in "$key" -outform DER 2> /dev/null | tail -c +8 | head -c 32 | base64 -w0 | tr '+/' '-_' | tr -d '=')
    pub=$(openssl ec -in "$key" -pubout -outform DER 2> /dev/null | tail -c 65 | base64 -w0 | tr '+/' '-_' | tr -d '=')
    rm -f "$key"
    envset FX_PUSH_VAPID_PUBLIC_KEY "$pub"; envset FX_PUSH_VAPID_PRIVATE_KEY "$priv"
    unset priv pub
    ok "FX_PUSH_VAPID_PUBLIC_KEY、FX_PUSH_VAPID_PRIVATE_KEY：已生成（$(env_name)专用一对）"
  else
    ok "FX_PUSH_VAPID_*：已有，不改"
  fi
  if [ ! -f "$STATE/backup.key" ]; then
    age-keygen -o "$STATE/backup.key" 2> /dev/null; chmod 600 "$STATE/backup.key"
    ok "备份加密密钥：已生成（本机，谁都不用看）"
  else
    ok "备份加密密钥：已有"
  fi
  age-keygen -y "$STATE/backup.key" > "$STATE/backup.pub"
}

cmd_install() {
  need_root
  if [ "${1:-}" = --production ]; then shift; cmd_install_production "$@"; return; fi
  { [ -n "$CALLER_ENV" ] && [ "$CALLER_ENV" != staging ]; } && die "命令里写的是 TR_ENV=$CALLER_ENV：装生产要写 sudo trading install --production …"
  prod && die "这台机器装的是生产（.env 的 TR_ENV=production）：环境装好后不能改，什么都没动"
  [ $# -ge 5 ] || die "用法：sudo trading install <客户端域名> <后台域名> <官网域名> <报价域名> <告警邮箱> [TopUP 测试环境地址]（填密钥用 sudo trading setup）"
  local app=$1 admin=$2 www=$3 quote=$4 email=$5 topup=${6:-} d
  for d in "$app" "$admin" "$www" "$quote"; do [[ "$d" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || die "域名格式不对：$d"; done
  [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+$ ]] || die "邮箱格式不对"
  [ -z "$topup" ] || [[ "$topup" =~ ^https://[a-z0-9.-]+$ ]] || die "TopUP 地址要是 https://域名（不带路径）"
  mkdir -p "$TR_DIR/logs"
  # 中途失败时提醒怎么收拾（按模式：轮流模式 TopUP 可能已被停下，运行 trading off 恢复；独立模式没碰 TopUP）
  INSTALL_HINT=1
  say "== Trading 测试环境第一次部署（可以重复运行；每步 ✓ / ✗，最后打印摘要，不显示任何密钥）"

  say "== 1/9 检查系统、80/443 和内存（轮流模式 TR_SHARE_WITH_TOPUP=true 时先停 TopUP；默认独立，不碰 TopUP）"
  . /etc/os-release
  [ "${VERSION_ID:-}" = 24.04 ] && ok "Ubuntu 24.04" || bad "本脚本按 Ubuntu 24.04 写，这台是 ${PRETTY_NAME:-未知}（继续，出错截图）"
  stop_topup_and_check_mem || exit 1

  say "== 2/9 安装 Docker、certbot、age（备份加密）、jq；Docker 日志按大小轮转；系统自动安全更新"
  export DEBIAN_FRONTEND=noninteractive
  if ! command -v docker > /dev/null || ! docker compose version > /dev/null 2>&1 || ! command -v certbot > /dev/null || ! command -v age > /dev/null; then
    apt-get update -q > /dev/null
    apt-get install -y -q docker.io docker-compose-v2 certbot age jq curl unattended-upgrades > /dev/null
  fi
  mkdir -p /etc/docker
  # 已有 daemon.json（TopUP 装过）就不动它、不重启 Docker
  if [ ! -f /etc/docker/daemon.json ]; then
    printf '{ "log-driver": "json-file", "log-opts": { "max-size": "50m", "max-file": "3" } }\n' > /etc/docker/daemon.json
    systemctl restart docker
  fi
  systemctl enable --now docker > /dev/null 2>&1 || true
  ok "$(docker --version)"; ok "$(docker compose version)"; ok "$(certbot --version 2>&1)"; ok "age $(age --version)"

  say "== 3/9 目录和 .env（只有 root 能读）"
  mkdir -p "$TR_DIR"/{data/mysql,data/redis,data/storage,backup,backup/photos,state,logs} /var/www/certbot
  chown -R 10001 "$TR_DIR/data/storage"
  chmod 700 "$TR_DIR/backup" "$TR_DIR/state"
  [ -f "$ENVF" ] || cp "$TR_DIR/.env.example" "$ENVF"
  chmod 600 "$ENVF"
  guard_env
  ln -sf "$TR_DIR/trading" /usr/local/bin/trading
  ok "$TR_DIR"

  say "== 4/9 域名、邮箱（不是密钥）"
  envset APP_DOMAIN "$app"; envset ADMIN_DOMAIN "$admin"; envset WWW_DOMAIN "$www"; envset QUOTE_DOMAIN "$quote"; envset CERT_EMAIL "$email"
  [ -n "$(envget FX_ALERT_EMAILS)" ] || envset FX_ALERT_EMAILS "$email"
  [ -n "$(envget FX_RISK_ALERT_EMAILS)" ] || envset FX_RISK_ALERT_EMAILS "$email"
  [ -z "$topup" ] || envset FX_TOPUP_BASE_URL "$topup"
  ok "客户端 $app、后台 $admin、官网 $www、报价 $quote"

  say "== 5/9 生成内部密码和 Key（写进 .env，不显示）"
