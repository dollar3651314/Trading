cmd_install() {
  need_root
  [ $# -ge 5 ] || die "用法：sudo trading install <客户端域名> <后台域名> <官网域名> <报价域名> <告警邮箱> [TopUP 测试环境地址]（填密钥用 sudo trading setup）"
  local app=$1 admin=$2 www=$3 quote=$4 email=$5 topup=${6:-} d
  for d in "$app" "$admin" "$www" "$quote"; do [[ "$d" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || die "域名格式不对：$d"; done
  [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+$ ]] || die "邮箱格式不对"
  [ -z "$topup" ] || [[ "$topup" =~ ^https://[a-z0-9.-]+$ ]] || die "TopUP 地址要是 https://域名（不带路径）"
  mkdir -p "$TR_DIR/logs"
  # 中途失败时提醒：TopUP 已被停下，要先恢复它就运行 trading off
  INSTALL_HINT=1
  say "== Trading 测试环境第一次部署（可以重复运行；每步 ✓ / ✗，最后打印摘要，不显示任何密钥）"

  say "== 1/9 停 TopUP、检查系统和内存（这台 2 核 2G 和 TopUP 轮流用）"
  . /etc/os-release
  [ "${VERSION_ID:-}" = 24.04 ] && ok "Ubuntu 24.04" || bad "本脚本按 Ubuntu 24.04 写，这台是 ${PRETTY_NAME:-未知}（继续，出错截图）"
  stop_topup_and_check_mem || exit 1

  say "== 2/9 安装 Docker、certbot、age（备份加密）、jq；Docker 日志按大小轮转；系统自动安全更新"
  export DEBIAN_FRONTEND=noninteractive
  if ! command -v docker > /dev/null || ! docker compose version > /dev/null 2>&1 || ! command -v certbot > /dev/null || ! command -v age > /dev/null; then
    apt-get update -q > /dev/null
    apt-get install -y -q docker.io docker-compose-v2 certbot age jq curl unattended-upgrades > /dev/null
  fi
  mkdir -p /etc/docker
  # 已有 daemon.json（TopUP 装过）就不动它、不重启 Docker
  if [ ! -f /etc/docker/daemon.json ]; then
    printf '{ "log-driver": "json-file", "log-opts": { "max-size": "50m", "max-file": "3" } }\n' > /etc/docker/daemon.json
    systemctl restart docker
  fi
  systemctl enable --now docker > /dev/null 2>&1 || true
  ok "$(docker --version)"; ok "$(docker compose version)"; ok "$(certbot --version 2>&1)"; ok "age $(age --version)"

  say "== 3/9 目录和 .env（只有 root 能读）"
  mkdir -p "$TR_DIR"/{data/mysql,data/redis,data/storage,backup,state,logs} /var/www/certbot
  chown -R 10001 "$TR_DIR/data/storage"
  chmod 700 "$TR_DIR/backup" "$TR_DIR/state"
  [ -f "$ENVF" ] || cp "$TR_DIR/.env.example" "$ENVF"
  chmod 600 "$ENVF"
  guard_env
  ln -sf "$TR_DIR/trading" /usr/local/bin/trading
  ok "$TR_DIR"

  say "== 4/9 域名、邮箱（不是密钥）"
  envset APP_DOMAIN "$app"; envset ADMIN_DOMAIN "$admin"; envset WWW_DOMAIN "$www"; envset QUOTE_DOMAIN "$quote"; envset CERT_EMAIL "$email"
  [ -n "$(envget FX_ALERT_EMAILS)" ] || envset FX_ALERT_EMAILS "$email"
  [ -n "$(envget FX_RISK_ALERT_EMAILS)" ] || envset FX_RISK_ALERT_EMAILS "$email"
  [ -z "$topup" ] || envset FX_TOPUP_BASE_URL "$topup"
  ok "客户端 $app、后台 $admin、官网 $www、报价 $quote"

  say "== 5/9 生成内部密码和 Key（写进 .env，不显示）"
  set_if_empty MYSQL_ROOT_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_DB_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_QUOTE_DB_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_REDIS_PASSWORD "$(rand_hex 24)"
  set_if_empty FX_QUOTE_INTERNAL_KEY "$(rand_hex 32)"
  set_if_empty FX_QUOTE_KEY_ENC_KEY "$(rand_hex 32)"
  if [ -z "$(envget FX_PUSH_VAPID_PRIVATE_KEY)" ]; then
    local key pub priv
    key=$(mktemp)
    openssl ecparam -name prime256v1 -genkey -noout -out "$key" 2> /dev/null
    priv=$(openssl ec -in "$key" -outform DER 2> /dev/null | tail -c +8 | head -c 32 | base64 -w0 | tr '+/' '-_' | tr -d '=')
    pub=$(openssl ec -in "$key" -pubout -outform DER 2> /dev/null | tail -c 65 | base64 -w0 | tr '+/' '-_' | tr -d '=')
    rm -f "$key"
    envset FX_PUSH_VAPID_PUBLIC_KEY "$pub"; envset FX_PUSH_VAPID_PRIVATE_KEY "$priv"
    unset priv pub
    ok "FX_PUSH_VAPID_PUBLIC_KEY、FX_PUSH_VAPID_PRIVATE_KEY：已生成（测试专用一对）"
  else
    ok "FX_PUSH_VAPID_*：已有，不改"
  fi
  envset FX_PUSH_VAPID_SUBJECT "mailto:$email"
  if [ ! -f "$STATE/backup.key" ]; then
    age-keygen -o "$STATE/backup.key" 2> /dev/null; chmod 600 "$STATE/backup.key"
    ok "备份加密密钥：已生成（本机，谁都不用看）"
  else
    ok "备份加密密钥：已有"
  fi
  age-keygen -y "$STATE/backup.key" > "$STATE/backup.pub"

  say "== 6/9 HTTPS 证书（Let's Encrypt，一张证书四个子域名）"
  if [ ! -f /etc/letsencrypt/live/trading/fullchain.pem ]; then
    # 第一次：TopUP 已停、80 空着，用 certbot 自己的临时服务验证；之后改成 webroot（/var/www/certbot），哪边的 Nginx 在跑就由哪边应答（07 页第 5 节）
    compose stop trading-web > /dev/null 2>&1 || true
    if certbot certonly --standalone -n --agree-tos -m "$email" --cert-name trading -d "$app" -d "$admin" -d "$www" -d "$quote" > /dev/null 2>&1; then
      ok "证书已申请"
    else
      die "证书申请失败：检查四条 DNS 是不是都指向这台服务器、Cloudflare 是\"仅 DNS\"（灰云）、防火墙开了 80。日志：/var/log/letsencrypt/letsencrypt.log"
    fi
  else
    ok "已有证书"
  fi

  say "== 7/9 启动 staging 最新版本（第一次要下载镜像，约 3–5 分钟）"
  if ! pull "$REG/trading-app:staging"; then
    die "拉不到镜像 $REG/trading-app:staging：GitHub 上三个包（trading-app、trading-quote、trading-web）要先设为 Public（操作步骤第 6 步），或者 CI 还没推出第一个镜像"
  fi
  TR_FIRST=1 cmd_update || die "启动失败，看 $LOGF；改好后再运行同一条命令"

  say "== 8/9 证书改为经 Nginx 自动续期（续完自动重新加载 Nginx）；打开定时器"
  certbot reconfigure -n --cert-name trading --webroot -w /var/www/certbot --deploy-hook "docker exec trading-trading-web-1 nginx -s reload || true" > /dev/null 2>&1 \
    && ok "证书自动续期" || bad "证书续期设置失败（不影响现在使用，截图给主会话）"
  install_units
  sysctl_ enable --now "${TIMERS[@]}" > /dev/null 2>&1 && ok "定时器：每分钟更新（trading-deploy）、每天北京时间 03:30 备份、每 5 分钟检查"
  if [ -z "$(ls -A "$TR_DIR/backup" 2>/dev/null)" ]; then
    if cmd_backup first > /dev/null; then ok "第一份备份"; else bad "第一份备份没做成（原因见上面一行；不影响使用，之后每天北京时间 03:30 自动备份，也可以 sudo trading backup）"; fi
  fi

  say "== 9/9 摘要（没有任何密钥）"
  cmd_status
  say "现在 Trading 在跑、TopUP 停着。下一步：sudo trading setup（中文向导，填邮件、后台初始密码、验收令牌）；验收完运行 sudo trading off 切回 TopUP。"
}

# 读同机 TopUP 配置里的一个值（只读；没有这个文件或这一项时为空）
topup_val() { [ -r "$TOPUP_ENVF" ] && awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); v=$0} END{printf "%s", v}' "$TOPUP_ENVF" || true; }

# 邮件：同机有 TopUP 时沿用它的发件地址、收件人（MAIL_FROM、MAIL_TO），问要不要沿用它的 Resend Key（本地复制，不显示）；
# 读不到（临时第二台）时逐项问。告警收件人 = MAIL_TO，FX_PUSH_VAPID_SUBJECT = mailto:MAIL_TO 的第一个
setup_mail() {
  local from to yn key shost
  from=$(topup_val MAIL_FROM); to=$(topup_val MAIL_TO)
  if [ -n "$from" ] && [ -n "$to" ]; then
    envset FX_MAIL_FROM "$from"; envset FX_ALERT_EMAILS "$to"; envset FX_RISK_ALERT_EMAILS "$to"
    ok "发件地址、收件人：沿用 TopUP 的（$from → $to）"
    key=$(topup_val RESEND_API_KEY); shost=$(topup_val SMTP_HOST)
    if [ -n "$key" ] || [ -n "$shost" ]; then
      read -r -p "是否沿用 TopUP 的 Resend Key（是 = 直接回车或输入 是，否 = 输入 否）：" yn || true
    else
      yn=否; ok "TopUP 的配置里没有 Resend Key，下面隐藏输入"
    fi
    if [ "$yn" != 否 ] && [ "$yn" != n ] && [ "$yn" != N ] && [ -n "$key" ]; then
      # Resend 的 SMTP：用户名 resend、密码就是 API Key（TopUP 用的是 Resend 的接口，同一个 Key）
      envset FX_MAIL_HOST smtp.resend.com; envset FX_MAIL_PORT 587; envset FX_MAIL_SECURITY STARTTLS; envset FX_MAIL_USERNAME resend
      envset FX_MAIL_PASSWORD "$key"; unset key
      ok "Resend Key：已从 TopUP 的配置本地复制（不显示值）"
    elif [ "$yn" != 否 ] && [ "$yn" != n ] && [ "$yn" != N ] && [ -n "$shost" ]; then
      envset FX_MAIL_HOST "$shost"; envset FX_MAIL_PORT "$(topup_val SMTP_PORT)"; envset FX_MAIL_USERNAME "$(topup_val SMTP_USER)"
      if [ "$(topup_val SMTP_SECURE)" = true ]; then envset FX_MAIL_SECURITY SSL; else envset FX_MAIL_SECURITY STARTTLS; fi
      envset FX_MAIL_PASSWORD "$(topup_val SMTP_PASS)"
      ok "SMTP 设置：已从 TopUP 的配置本地复制（不显示值）"
    else
      envset FX_MAIL_HOST smtp.resend.com; envset FX_MAIL_PORT 587; envset FX_MAIL_SECURITY STARTTLS; envset FX_MAIL_USERNAME resend
      ask_secret FX_MAIL_PASSWORD "Resend API Key（权限 Sending access、只选发信域名）"
    fi
    unset key
    envset FX_PUSH_VAPID_SUBJECT "mailto:${to%%,*}"
    apply > /dev/null || true
    cmd_test_mail || true
  else
    ok "这台机器上读不到 TopUP 的邮件设置（临时第二台？），逐项输入"
    cmd_keys mail
    to=$(envget FX_ALERT_EMAILS)
    [ -z "$to" ] || { envset FX_PUSH_VAPID_SUBJECT "mailto:${to%%,*}"; apply > /dev/null || true; }
  fi
}

# 第一个超管：库里还没有管理员时，用这次输入的初始密码建（首次登录必须改），建好立刻从 .env 删掉
setup_admin() {
  if [ -f "$STATE/admin-created" ]; then ok "后台超管：已建过（忘了密码请在后台用另一个超管重置）"; return 0; fi
  local p1 p2
  read_secret "后台第一个超管的初始密码（至少 10 位、有字母和数字；从密码管理器粘；直接回车 = 跳过）："; p1=$REPLY_SECRET
  [ -n "$p1" ] || { ok "后台超管：这次跳过"; return 0; }
  read_secret "再粘一次确认："; p2=$REPLY_SECRET; REPLY_SECRET=
  [ "$p1" = "$p2" ] || { bad "两次不一样，没保存（再运行 sudo trading setup）"; return 1; }
  [ ${#p1} -ge 10 ] && [[ "$p1" =~ [A-Za-z] ]] && [[ "$p1" =~ [0-9] ]] || { bad "密码不够强（至少 10 位、有字母和数字）"; return 1; }
  envset FX_ADMIN_INIT_USERNAME admin; envset FX_ADMIN_INIT_PASSWORD "$p1"; unset p1 p2
  apply > /dev/null || true
  if compose logs --no-color trading-app 2>/dev/null | grep -q '已建第一个超级管理员'; then
    touch "$STATE/admin-created"; ok "后台超管已建：用户名 admin，首次登录必须改密码"
  else
    bad "后台超管没建成（库里已经有管理员，或密码不合规则；看 sudo trading status）"
  fi
  envdel FX_ADMIN_INIT_PASSWORD; envdel FX_ADMIN_INIT_USERNAME
  apply > /dev/null || true
}

# 验收令牌（做法 07）：粘一串令牌（同一串填进 GitHub 环境 staging-e2e），服务器只存它的 SHA-256
# 验收令牌（TD4-15）：Amos 用密码管理器生成一串 40 位（字母和数字），这里隐藏输入；同一串由 Amos 填进 GitHub 环境 staging-e2e。
# 服务器只存 SHA-256，屏幕上、日志里都不出现原文；再输入一串就换掉旧的
setup_test_admin() {
  local t
  read_secret "验收令牌（密码管理器生成的 40 位字母和数字；屏幕上不显示；直接回车 = 跳过）："; t=$REPLY_SECRET; REPLY_SECRET=
  [ -n "$t" ] || { ok "验收令牌：这次跳过（以后用 sudo trading gen-test-admin 再填）"; return 0; }
  [[ "$t" =~ ^[A-Za-z0-9]{40,}$ ]] || { unset t; bad "令牌要是至少 40 位的字母和数字，没保存"; return 1; }
  envset TEST_ADMIN_TOKEN_SHA256 "$(printf '%s' "$t" | sha256sum | cut -d' ' -f1)"; unset t
  apply > /dev/null || true
  ok "验收令牌已保存（服务器只存哈希）；同一串填进 GitHub → Trading 仓库 → Settings → Environments → staging-e2e → STAGING_TEST_ADMIN_TOKEN"
  log "测试管理员令牌已更换（不记录令牌）"
}

cmd_setup() {
  need_root; need_tty
  [ -f "$ENVF" ] && [ -n "$(current_tag)" ] || die "还没安装：先运行主会话给的一次性安装命令（sudo trading install …）"
  say "Trading 测试环境中文向导。要粘的 Key、密码、令牌在屏幕上不显示，也不写进日志；每项直接回车 = 跳过 / 不改。"
  say "-- ① 邮件"
  setup_mail
  say "-- ② 后台第一个超管"
  setup_admin || true
  say "-- ③ 验收令牌"
  if [ "$(health_field env "$(health)")" = test ]; then setup_test_admin || true; else bad "健康检查的 env 不是 test，不设测试管理员"; fi
  say "-- ④ TopUP（平时这台跳过；联调时在临时机填）"
  local yn
  read -r -p "现在填 TopUP 的 Key / Secret 吗？（y = 填，直接回车 = 跳过）：" yn || true
  if [ "$yn" = y ] || [ "$yn" = Y ]; then cmd_keys topup; else ok "TopUP：这次跳过"; fi
  say "-- ⑤ 备份"
  if cmd_backup setup > /dev/null; then ok "备份：本机已加密"; else bad "备份失败（原因见上面一行；看 $LOGF，截图给主会话）"; fi
  # 2 核 2G 上 Trading 在跑时再起一个临时 MySQL 会抢内存（11/17 测试服务器上卡住过），恢复演练改在 trading off 时做
  ok "恢复演练：不在这里做。sudo trading off 时自动做（那时 Trading 已全停、TopUP 还没启动，内存够）"
