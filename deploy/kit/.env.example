# Trading /opt/trading/.env 的变量清单（测试环境：部署方案 v1 04 页；生产：生产方案 v1 04 页）。这里只有名字，没有值（底线 1）。
# 服务器上的 .env 权限 600，由 trading setup 从本文件建好；值的来源：
#   [生成] trading setup 在服务器上随机生成，谁都不用看
#   [Amos] Amos 用 sudo trading keys（隐藏输入）填；不经过对话、不截图
#   [命令] trading setup 的参数（域名、邮箱，不是密钥）
# 不在下面的变量（报价模式、端口、库地址等部署决定）写在 docker-compose.yml 里。FX_E2E_ENABLED 一律不能设（trading 命令发现就拒绝启动）。

# [可调，默认不填 = 用 docker-compose.yml 里的默认值，合计 964 MB；Amos 11/17 选 B，批准的 C75 例外，11/17 测试服务器实测后调整] 容器内存上限、JVM 上限、连接池
# TR_MEM_APP=348m   TR_HEAP_APP=144m  TR_META_APP=104m TR_CODE_APP=40m  TR_DIRECT_APP=16m  TR_DB_POOL_APP=12
# TR_MEM_QUOTE=312m TR_HEAP_QUOTE=64m TR_META_QUOTE=96m TR_CODE_QUOTE=28m TR_DIRECT_QUOTE=8m  TR_DB_POOL_QUOTE=3
# TR_MEM_MYSQL=272m TR_MYSQL_BUFFER_POOL=32M   TR_MEM_REDIS=16m   TR_MEM_WEB=16m
#   所有容器都不用交换分区（memswap = 内存）；以前的 TR_MEMSWAP_MYSQL 已经不用（11/18），.env 里有可以删
# 环境变量（不在 .env）：TR_MIN_MEM_MB 启动门槛默认 1000（964 + 容器运行开销约 36；生产 2600）；TR_MEMGUARD_MB 内存守护阈值默认 80（生产 300）；TR_DRILL_MEM_MB 恢复演练临时库默认 320（trading off 时做，那时 Trading 已全停；生产 512，TR_DRILL_NEED_MB 生产要可用 800）；TR_BACKUP_MAX_MB 数据库备份合计上限默认 2048（生产 600）；TR_LOG_MAX_BYTES trading.log 轮转大小默认 10 MB（留 5 个）；TR_INSTALL_MIN_DISK_MB 生产安装要的剩余磁盘默认 4096；TR_UPDATE_MIN_DISK_MB、TR_DRILL_MIN_DISK_MB 更新、恢复演练在备份大小之外要的剩余磁盘默认 2048（这三个只给开发机演练调低，服务器上不设）；TR_DUMP_TIMEOUT 备份时 mysqldump 最多等几秒，默认 300（要明显小于自动更新服务的 15 分钟）；TR_DRILL_READY_TIMEOUT、TR_DRILL_IMPORT_TIMEOUT 恢复演练等临时库就绪、导入各最多几秒，默认 180、300；TR_OFF_LOCK_WAIT trading off 等进行中的自动更新最多几秒，默认 300

# [命令] 环境：production = 生产（sudo trading install --production 写，之后不能改；不写 = 测试环境）。
#   生产的容器设置在 docker-compose.production.yml（内存、CPU、端口、报价 live 等，默认值和测试环境不同，名字一样的 TR_MEM_* 等照样能改）
TR_ENV=

# [命令] 四个子域名、证书和告警邮箱（生产：平台给 8082、8083、8084、8085 的主机名，没有证书和证书邮箱；报价主机名可以空）
APP_DOMAIN=
ADMIN_DOMAIN=
WWW_DOMAIN=
QUOTE_DOMAIN=
CERT_EMAIL=

# [生成] 数据库、Redis
MYSQL_ROOT_PASSWORD=
FX_DB_PASSWORD=
FX_QUOTE_DB_PASSWORD=
FX_REDIS_PASSWORD=

# [生成] trading-app 和报价服务之间的内部 Key（两边同一个值）；报价对外 Key 的加密密钥（生成后不能换，进加密备份）
FX_QUOTE_INTERNAL_KEY=
FX_QUOTE_KEY_ENC_KEY=

# [Amos] 第一个超级管理员（trading setup 向导里隐藏输入；系统里还没有管理员时用，首次登录必须改密码；建好后自动删掉这两行）
FX_ADMIN_INIT_USERNAME=
FX_ADMIN_INIT_PASSWORD=

# [生成] 浏览器推送（测试专用一对，生成后不要换）；SUBJECT = mailto:告警邮箱
FX_PUSH_VAPID_PUBLIC_KEY=
FX_PUSH_VAPID_PRIVATE_KEY=
FX_PUSH_VAPID_SUBJECT=

# [命令] 和 TopUP 轮流用这台机器吗（sudo trading set TR_SHARE_WITH_TOPUP true|false）：没写或 false = 独立，trading on / off 不碰 TopUP
#   （11/18 起：TopUP 测试环境搬到了别的机器）；Trading 上生产、TopUP 搬回来以后设 true，on 先 topup stop、off 最后 topup start
TR_SHARE_WITH_TOPUP=

# [命令，只有生产] 真实 IP（默认关；实测平台网关后 sudo trading set TR_REAL_IP_FROM <网关地址段> 和 TR_REAL_IP_HEADER X-Forwarded-For|X-Real-IP，两项都填才开；
#   不能和 Docker 的 172.17～172.31 重叠）；报价对外端口 8085 绑在哪（默认 127.0.0.1 = 不对外；平台上发布 8085 时 sudo trading set TR_QUOTE_BIND 0.0.0.0）
TR_REAL_IP_FROM=
TR_REAL_IP_HEADER=
TR_QUOTE_BIND=

# [Amos] TopUP 商户（测试环境：TopUP 测试；生产：TopUP 生产的"Trading"商户，主网、真钱）（BASE_URL 不是密钥，trading keys 里预填默认值、可改；11/18 起是外部地址）
FX_TOPUP_BASE_URL=
FX_TOPUP_API_KEY=
FX_TOPUP_API_SECRET=

# [Amos] 邮件 SMTP（HOST、PORT、SECURITY、USERNAME、FROM 不是密钥；PASSWORD 是）
FX_MAIL_HOST=
FX_MAIL_PORT=
FX_MAIL_SECURITY=
FX_MAIL_USERNAME=
FX_MAIL_PASSWORD=
FX_MAIL_FROM=

# [命令] 告警、风控通知收件人（逗号分隔；测试环境同一个）
FX_ALERT_EMAILS=
FX_RISK_ALERT_EMAILS=

# [Amos，默认不填] 真实报价源 token（TD4-12）；币安只读行情默认打开（TD4-11），要关填 false
FX_QUOTE_ALLTICK_TOKEN=
FX_QUOTE_ITICK_TOKEN=
FX_QUOTE_BINANCE_ENABLED=

# [Amos] Telegram 机器人（TG 机器人第 1 批）：先 sudo trading set FX_TG_BOT_USERNAME（测试 TradingAssistTestBot、生产 TradingAssistBot，不填用这两个默认值），
# 再 sudo trading set-key FX_TG_BOT_TOKEN（BotFather 给的令牌，隐藏输入；只由 Amos 填）。没填令牌 = 机器人不启动
FX_TG_BOT_USERNAME=
FX_TG_BOT_TOKEN=
# [Amos] 第 2 批：先在 BotFather 对机器人 /setdomain 绑上网页客户端的域名，再 sudo trading set FX_TG_WEB_URL https://<客户端域名>（不填 = 机器人不显示「打开交易」等按钮）；
# 绑不上时 sudo trading set FX_TG_LOGIN_MODE link（退路：一次性链接）。第一阶段只走 Telegram 默认开，要临时打开网页注册登录：sudo trading set FX_PHASE1_TELEGRAM_ONLY false
FX_TG_WEB_URL=
FX_TG_LOGIN_MODE=
FX_PHASE1_TELEGRAM_ONLY=

# [Amos] 测试管理员令牌的 SHA-256（Amos 用密码管理器生成 40 位，trading setup 或 sudo trading gen-test-admin 隐藏输入；服务器只存哈希）。生产不能有
TEST_ADMIN_TOKEN_SHA256=
