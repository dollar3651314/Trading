# Trading 测试环境 /opt/trading/.env 的变量清单（部署方案 v1 04 页）。这里只有名字，没有值（底线 1）。
# 服务器上的 .env 权限 600，由 trading setup 从本文件建好；值的来源：
#   [生成] trading setup 在服务器上随机生成，谁都不用看
#   [Amos] Amos 用 sudo trading keys（隐藏输入）填；不经过对话、不截图
#   [命令] trading setup 的参数（域名、邮箱，不是密钥）
# 不在下面的变量（报价模式、端口、库地址等部署决定）写在 docker-compose.yml 里。FX_E2E_ENABLED 一律不能设（trading 命令发现就拒绝启动）。

# [命令] 模式：standalone（单独一台）或 shared（和 TopUP 共机，setup --shared）；共机时 Redis 用 TopUP 的，db 编号默认 2
TR_MODE=
TR_REDIS_DB=

# [可调，默认不填 = 用 docker-compose.yml 里偏小的默认值；最终数以部署方案为准] 容器内存上限和 JVM 上限
# TR_MEM_APP=640m      TR_HEAP_APP=320m    TR_META_APP=150m
# TR_MEM_QUOTE=384m    TR_HEAP_QUOTE=160m  TR_META_QUOTE=120m
# TR_MEM_MYSQL=384m    TR_MYSQL_BUFFER_POOL=128M
# TR_MEM_REDIS=64m（只单独模式）  TR_MEM_WEB=32m
# TR_MIN_MEM_MB=（setup 的可用内存门槛；默认共机 1000、单独 1600）

# [命令] 四个子域名、证书和告警邮箱
APP_DOMAIN=
ADMIN_DOMAIN=
WWW_DOMAIN=
QUOTE_DOMAIN=
CERT_EMAIL=

# [生成] 数据库、Redis（共机时 FX_REDIS_PASSWORD 从 TopUP 的 deploy.env 读，只读不改）
MYSQL_ROOT_PASSWORD=
FX_DB_PASSWORD=
FX_QUOTE_DB_PASSWORD=
FX_REDIS_PASSWORD=

# [生成] trading-app 和报价服务之间的内部 Key（两边同一个值）；报价对外 Key 的加密密钥（生成后不能换，进加密备份）
FX_QUOTE_INTERNAL_KEY=
FX_QUOTE_KEY_ENC_KEY=

# [生成] 第一个超级管理员（系统里还没有管理员时用；首次登录必须改密码。建好后 trading 自动删掉这两行）
FX_ADMIN_INIT_USERNAME=
FX_ADMIN_INIT_PASSWORD=

# [生成] 浏览器推送（测试专用一对，生成后不要换）；SUBJECT = mailto:告警邮箱
FX_PUSH_VAPID_PUBLIC_KEY=
FX_PUSH_VAPID_PRIVATE_KEY=
FX_PUSH_VAPID_SUBJECT=

# [Amos] TopUP 测试环境商户（BASE_URL 不是密钥，trading keys 里预填默认值、可改）
FX_TOPUP_BASE_URL=
FX_TOPUP_API_KEY=
FX_TOPUP_API_SECRET=

# [Amos] 邮件 SMTP（HOST、PORT、SECURITY、USERNAME、FROM 不是密钥；PASSWORD 是）
FX_MAIL_HOST=
FX_MAIL_PORT=
FX_MAIL_SECURITY=
FX_MAIL_USERNAME=
FX_MAIL_PASSWORD=
FX_MAIL_FROM=

# [命令] 告警、风控通知收件人（逗号分隔；测试环境同一个）
FX_ALERT_EMAILS=
FX_RISK_ALERT_EMAILS=

# [Amos，默认不填] 真实报价源 token（TD4-12）；币安只读行情默认打开（TD4-11），要关填 false
FX_QUOTE_ALLTICK_TOKEN=
FX_QUOTE_ITICK_TOKEN=
FX_QUOTE_BINANCE_ENABLED=

# [生成] 测试管理员令牌的 SHA-256（sudo trading gen-test-admin；令牌原文只在终端显示一次）。生产不能有
TEST_ADMIN_TOKEN_SHA256=
